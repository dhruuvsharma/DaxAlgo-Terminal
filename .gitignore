# Build output
bin/
obj/
out/
[Bb]uild/
# ...but /build/ is OURS: the repo's build scripts (gen-ai-context.ps1, gen-trusted-plugins.ps1) live
# there and CI runs them. The rule above swallowed the directory, so the scripts were never committed
# and the template-smoke drift check ran against a script that didn't exist.
!/build/
[Pp]ublish/
installer/Output/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET
*.dll
*.pdb
*.exe
project.lock.json
project.fragment.lock.json
artifacts/

# IDE
.vs/
.vscode/
.idea/
*.swp
*.tmp

# Test output
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Logs (project)
logs/
*.log

# OS
Thumbs.db
.DS_Store

# Environment overrides
appsettings.local.json
appsettings.*.local.json

# IB binaries (user must drop these locally)
lib/IBApi.dll
lib/IBApi.pdb

# Don't ignore the lib placeholder
!lib/.gitkeep

# Claude local settings (project-level overrides)
.claude/settings.local.json

# Backtest scratch output (synthetic parquet datasets, run outputs)
*.parquet
bt-results/
bt-data*/

# Local demo/screenshot assets (not tracked)
test/

# Python compiled
__pycache__/
*.pyc

# Claude agent worktrees (temporary)
.claude/worktrees/

# Local agent tooling (Claude Code / Codex). Kept on disk for local use, deliberately
# untracked: the public repository ships the product, not the authoring workflow.
.claude/
.agents/
.codex/
CLAUDE.md
AGENTS.md
claude-here.bat
claude-launch.bat
# Not part of the base application: task records, polyglot sidecars (Python ML / C++), and
# forward-looking idea notes. Kept on disk locally, deliberately untracked. Authored
# documentation and its screenshots under docs/ ARE tracked and ship with the repository.
tasks/
/images/
/tools/
ideas.md
build/gen-ai-context.ps1
scripts/setup-claude-code.bat
researchpapers/

# Benchmark reference captures are the vendors' screenshots, not ours, and this repository is
# public. The briefs link to each vendor's own page; the captures stay on disk. See
# docs/hyperion-benchmark/reference/README.md.
docs/hyperion-benchmark/reference/*
!docs/hyperion-benchmark/reference/README.md

# WPF compiles in two passes and writes a throwaway <Project>_<token>_wpftmp.csproj beside the real
# one. A build that is interrupted leaves it there, and the context checker then tries to parse it as
# a project and fails the gate. Generated, never committed.
*_wpftmp.csproj
