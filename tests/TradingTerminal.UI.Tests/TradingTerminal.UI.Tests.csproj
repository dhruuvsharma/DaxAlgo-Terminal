<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <!-- The controls under test are WPF, and the render surface writes into a real DrawingContext. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\windows\Shell\TradingTerminal.UI\TradingTerminal.UI.csproj" />
    <ProjectReference Include="..\..\src\windows\Shell\TradingTerminal.Login\TradingTerminal.Login.csproj" />
    <ProjectReference Include="..\..\src\windows\UI\TradingTerminal.Settings\TradingTerminal.Settings.csproj" />
    <ProjectReference Include="..\..\src\windows\Charts\TradingTerminal.Workspace\TradingTerminal.Workspace.csproj" />
    <!-- The shipped samples, so registration is proven against units known to be correct rather
         than against stand-ins written to pass. -->
    <ProjectReference Include="..\..\samples\DaxAlgo.Sandbox.Samples\DaxAlgo.Sandbox.Samples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
    <!-- WPF drawing requires an STA thread; StaFact supplies [WpfFact]/[WpfTheory]. -->
    <PackageReference Include="Xunit.StaFact" Version="1.2.69" />
  </ItemGroup>

</Project>
