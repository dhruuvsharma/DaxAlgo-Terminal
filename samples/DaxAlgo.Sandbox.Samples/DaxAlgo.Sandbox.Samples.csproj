<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build against the current open-core SDK source before its next NuGet release. -->
    <ProjectReference Include="..\..\src\windows\Sdk\DaxAlgo.Sdk\DaxAlgo.Sdk.csproj" />

    <!-- Project references do not propagate analyzers, so samples opt in explicitly. -->
    <ProjectReference Include="..\..\src\windows\Sdk\DaxAlgo.Sdk.Analyzers\DaxAlgo.Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nested test project is solution-visible but not source for this sample assembly. -->
    <Compile Remove="DaxAlgo.Sandbox.Samples.Tests\**\*.cs" />

    <!-- Documentation only: this file must never enter Compile items. -->
    <None Update="ForbiddenApis.cs.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
