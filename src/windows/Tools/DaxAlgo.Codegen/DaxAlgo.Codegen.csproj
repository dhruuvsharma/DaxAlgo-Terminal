<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lean AI-codegen assembly: the strategy-codegen contract impls, provider clients, build-loop
       orchestrator, provider factory, the embedded context pack, and the DI wiring. Split out of
       Infrastructure (which is UseWPF=true) so a console tool (the `daxalgo strategy` CLI) can reuse the
       codegen without dragging WPF + brokers into a global tool. Types keep the
       TradingTerminal.Infrastructure.Strategies.Authoring namespace, so Infrastructure and every existing
       consumer are unchanged — Infrastructure just references this project. Depends only on Core (WPF-free,
       windows-targeted) + Microsoft.Extensions. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\TradingTerminal.Core\TradingTerminal.Core.csproj" />
    <!-- The contract Hyperion writes against. Referenced so the authoring surface handed to a model
         is REFLECTED from the SDK rather than described by hand — the previous pack drifted precisely
         because its generator went missing and the prose was left to be maintained manually. -->
    <ProjectReference Include="..\..\Sdk\DaxAlgo.Sdk\DaxAlgo.Sdk.csproj" />
    <!-- SandboxParameters, so the verifier converts declared values EXACTLY as the host does. A
         second implementation would eventually disagree, and a verifier that disagrees with the host
         either passes units that fail live or fails units that would have worked. -->
    <ProjectReference Include="..\..\Pipeline\TradingTerminal.Sandbox\TradingTerminal.Sandbox.csproj" />
    <InternalsVisibleTo Include="TradingTerminal.Tests.Headless" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GENERATED authoring surface: every public SDK signature and its documentation, reflected
         from DaxAlgo.Sdk by SdkSurfaceGenerator. This is the half of the prompt that must never be
         written by hand — the previous pack was, its generator went missing, and it drifted until it
         taught a contract the authoring path no longer uses and said nothing at all about drawing.
         SdkSurfaceFreshnessTests fails when the committed copy falls behind. -->
    <EmbeddedResource Include="..\..\..\..\sdk\ai-context\generated\sdk-surface.md">
      <LogicalName>DaxAlgo.AiContext.SdkSurface.md</LogicalName>
    </EmbeddedResource>

    <!-- The hand-written half: judgement, conventions and worked reasoning. Facts about the contracts
         belong in the generated surface above, not here. Read via StrategyContextPack.Load(). -->
    <EmbeddedResource Include="..\..\..\..\sdk\ai-context\daxalgo-strategy-context.md">
      <LogicalName>DaxAlgo.AiContext.StrategyPack.md</LogicalName>
    </EmbeddedResource>

    <!-- On-demand domain packs (order flow, quant math, risk/exits, the live window, instruments). Loaded
         only when a brief calls for them, so the base prompt stays small AND the model gets depth on the
         thing actually being built. Read via StrategySkillLibrary.Load(). -->
    <EmbeddedResource Include="..\..\..\..\sdk\ai-context\skills\*.md">
      <LogicalName>DaxAlgo.AiContext.Skill.%(Filename).md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
