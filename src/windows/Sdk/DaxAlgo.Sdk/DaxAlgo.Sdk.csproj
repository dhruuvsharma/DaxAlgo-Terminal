<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── DaxAlgo plugin SDK (headless contract) ─────────────────────────────────────────────────
       The stable, UI-free surface an authored strategy or visualizer compiles against: the
       IStrategyKernel / IVisualizer contracts, IRenderSurface with the Drawing widget library, the
       Layout panel vocabulary, the Quant estimator library, the parameter schema, and the plugin
       seams.

       It said "quant math (TradingTerminal.Core.Quant)" from before the restructure, naming a
       namespace that has not existed in this tree since — and it said it in the file that publishes
       the package. That is the hand-maintained drift issue #44 is about. The maths is real again and
       lives in DaxAlgo.Sdk.Quant, inside this assembly.

       v1 is a curated FAÇADE over TradingTerminal.Core (the host's already broker-/UI-free contract
       layer): a plugin references DaxAlgo.Sdk instead of naming host projects directly, which is the
       boundary we version and (later) narrow. The matching UI base lives in DaxAlgo.Sdk.Wpf and
       the TFM follows the Windows host contract. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DaxAlgo.Sdk</PackageId>
    <Version>$(DaxAlgoSdkVersion)</Version>
    <PackageTags>daxalgo;trading;strategy;visualizer;plugin;sdk;quant;indicators</PackageTags>
    <Authors>DaxAlgo</Authors>
    <Description>DaxAlgo Terminal plugin SDK — the headless contract an authored strategy or visualizer compiles against: the IStrategyKernel and IVisualizer lifecycles, the IRenderSurface drawing surface and its widget library, the panel layout vocabulary, a streaming quant estimator library, the parameter schema, and the plugin seams.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\TradingTerminal.Core\TradingTerminal.Core.csproj" />
    <!-- Build the policy analyzer with the SDK and run it over this project, but keep it out of
         compile references and NuGet dependency metadata. Its assembly is embedded below. -->
    <ProjectReference Include="..\DaxAlgo.Sdk.Analyzers\DaxAlgo.Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- IPluginRegistrar exposes IServiceCollection so a plugin's Register() body mirrors a
         first-party AddXxxStrategy(). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet automatically loads analyzers from this path for every direct DaxAlgo.Sdk package
         consumer. DaxAlgoOutputBase handles both the Windows redirected build and normal CI output. -->
    <None Include="$(DaxAlgoOutputBase)src/windows/Sdk/DaxAlgo.Sdk.Analyzers/bin/$(Configuration)/netstandard2.0/DaxAlgo.Sdk.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
