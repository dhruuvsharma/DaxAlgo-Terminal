<UserControl x:Class="TradingTerminal.ExecutionUi.ExecutionConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TradingTerminal.ExecutionUi"
             xmlns:brokers="clr-namespace:TradingTerminal.Core.Brokers;assembly=TradingTerminal.Core"
             xmlns:loginForms="clr-namespace:TradingTerminal.App.Login.Forms;assembly=TradingTerminal.Login"
             xmlns:uiConverters="clr-namespace:TradingTerminal.UI.Converters;assembly=TradingTerminal.UI"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinWidth="1120"
             MinHeight="660"
             Background="{DynamicResource Background.Primary}"
             Foreground="{DynamicResource Text.Primary}"
             FontFamily="{DynamicResource Font.Base}"
             FontSize="12.5"
             TextOptions.TextFormattingMode="Display">
    <!--
        The Execution Desk (2026-09-26). Three columns, read left to right the way a desk works:
          left   - where orders can go (connections) and the books that send them;
          centre - the selected book (or all books): performance, positions, orders, fills, execution
                   quality, risk and the audit trail, one tab each;
          right  - acting on it: the order ticket and the strategy the book copies.
        The bar across the top is the whole desk at a glance. Every figure is the engine's own: fills,
        prices and fees from the OMS ledger, nothing sampled.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <uiConverters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <uiConverters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <local:ExecutionEqualsConverter x:Key="Equals" />

        <DataTemplate DataType="{x:Type loginForms:AlpacaLoginFormViewModel}">
            <loginForms:AlpacaLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:CTraderLoginFormViewModel}">
            <loginForms:CTraderLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:IbLoginFormViewModel}">
            <loginForms:IbLoginForm />
        </DataTemplate>
        <!-- Routed brokers (2026-09-25): the same forms the login window shows. -->
        <DataTemplate DataType="{x:Type loginForms:KeyedCryptoLoginFormBase}">
            <loginForms:KeyedCryptoLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:SessionBrokerLoginFormViewModel}">
            <loginForms:SessionLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:TradierLoginFormViewModel}">
            <loginForms:TradierLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:OandaLoginFormViewModel}">
            <loginForms:OandaLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:IronBeamLoginFormViewModel}">
            <loginForms:IronBeamLoginForm />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginForms:UpstoxLoginFormViewModel}">
            <loginForms:UpstoxLoginForm />
        </DataTemplate>

        <!-- ── Surfaces and type ─────────────────────────────────────────────────────────────── -->
        <Style x:Key="Execution.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style x:Key="Execution.CardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <Style x:Key="Execution.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Header}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Execution.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="Execution.Explain" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Execution.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Execution.Data" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Header}" />
        </Style>

        <!-- Colour by the ExecutionTone in Tag, so any tone property can drive any text. -->
        <Style x:Key="Execution.TagTone" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource Bullish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource Bearish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Accent}">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Execution.DataTone" TargetType="TextBlock" BasedOn="{StaticResource Execution.TagTone}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Execution.ToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource Bullish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource Bearish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A small status chip; its tone is in Tag. -->
        <Style x:Key="Execution.Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Positive}">
                    <Setter Property="Background" Value="{DynamicResource Bullish.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Bullish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Negative}">
                    <Setter Property="Background" Value="{DynamicResource Bearish.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Bearish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Warning.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static local:ExecutionTone.Info}">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Execution.ChipText" TargetType="TextBlock" BasedOn="{StaticResource Execution.TagTone}">
            <Setter Property="Tag" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="Execution.StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource Border.Strong}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Positive}">
                    <Setter Property="Fill" Value="{DynamicResource Bullish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Negative}">
                    <Setter Property="Fill" Value="{DynamicResource Bearish.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Warning}">
                    <Setter Property="Fill" Value="{DynamicResource Warning.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Buttons ────────────────────────────────────────────────────────────────────────── -->
        <Style x:Key="Execution.Button" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Base}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Execution.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Execution.Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource Accent.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
        </Style>

        <Style x:Key="Execution.WarningButton" TargetType="Button" BasedOn="{StaticResource Execution.Button}">
            <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Warning.Brush}" />
        </Style>

        <Style x:Key="Execution.DangerButton" TargetType="Button" BasedOn="{StaticResource Execution.Button}">
            <Setter Property="Foreground" Value="{DynamicResource Bearish.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Bearish.Soft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bearish.Brush}" />
        </Style>

        <Style x:Key="Execution.LinkButton" TargetType="Button" BasedOn="{StaticResource Execution.Button}">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="Execution.SmallButton" TargetType="Button" BasedOn="{StaticResource Execution.Button}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Execution.SmallDangerButton" TargetType="Button" BasedOn="{StaticResource Execution.DangerButton}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- One-of-many choices: tabs, segmented controls and the Buy/Sell pair are radio buttons. -->
        <Style x:Key="Execution.Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="11,9,11,7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Header}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Execution.Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="9,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent.Brush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Execution.SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Background.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Buy/Sell: fills with the side's colour (in Tag) when chosen. -->
        <Style x:Key="Execution.SideButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="{DynamicResource Background.Primary}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Figures ────────────────────────────────────────────────────────────────────────── -->
        <Style x:Key="Execution.Stat" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="13,7,13,7" />
        </Style>

        <Style x:Key="Execution.StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Execution.StatValue" TargetType="TextBlock" BasedOn="{StaticResource Execution.TagTone}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="Execution.StatSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style x:Key="Execution.Kpi" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Background.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Width" Value="146" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="Execution.KeyValueKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,10,2" />
        </Style>

        <Style x:Key="Execution.KeyValueValue" TargetType="TextBlock" BasedOn="{StaticResource Execution.TagTone}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <!-- ── Tables ─────────────────────────────────────────────────────────────────────────── -->
        <Style x:Key="Execution.Grid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <!-- Rows were the theme gap: cells and headers used theme brushes but DataGridRow was
                 unstyled, so rows fell back to the WPF default light chrome. -->
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Background.Primary}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Execution.NumericCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>

        <Style x:Key="Execution.MutedCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══ Desk bar: the whole desk at a glance ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Background.Surface}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,6,0">
                    <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource Accent.Brush}" Margin="0,0,9,0" />
                    <TextBlock Text="Execution Desk" Foreground="{DynamicResource Text.Header}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Kill all…"
                        Command="{Binding KillAllCommand}"
                        IsEnabled="{Binding CanKillAll}"
                        Style="{StaticResource Execution.DangerButton}"
                        VerticalAlignment="Center"
                        Margin="10,0,14,0"
                        ToolTip="Stops intake on every book, cancels every working order and flattens every position. Asks first, and says how many books are LIVE." />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Tag="{x:Static local:ExecutionTone.Warning}" Style="{StaticResource Execution.Chip}" Margin="0,0,6,0"
                            Visibility="{Binding Desk.HasReconciliationCases, Converter={StaticResource BooleanToVisibility}}"
                            ToolTip="A reconciliation difference blocks new orders on that book until it is resolved. See the book's Audit tab.">
                        <TextBlock Text="{Binding Desk.ReconciliationLabel}" Style="{StaticResource Execution.ChipText}" />
                    </Border>
                    <Border Tag="{x:Static local:ExecutionTone.Negative}" Style="{StaticResource Execution.Chip}"
                            Visibility="{Binding Desk.HasUnknownOutcomes, Converter={StaticResource BooleanToVisibility}}"
                            ToolTip="Orders whose outcome the broker never confirmed. Reconcile the book before trading it again.">
                        <TextBlock Text="{Binding Desk.UnknownLabel}" Style="{StaticResource Execution.ChipText}" />
                    </Border>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Execution.Stat}"
                            ToolTip="The application-wide switch. PAPER keeps every order in demo, testnet and paper accounts. REAL (armed in the login window) lets LIVE books send real-money orders, and each LIVE account also needs its own typed confirmation.">
                        <StackPanel>
                            <TextBlock Text="TRADING MODE" Style="{StaticResource Execution.StatLabel}" />
                            <Border Tag="{Binding ExecutionModeBannerTone}" Style="{StaticResource Execution.Chip}" HorizontalAlignment="Left" Margin="0,4,0,2" Padding="8,1,8,2">
                                <TextBlock Text="{Binding ExecutionModeShortLabel}" Style="{StaticResource Execution.ChipText}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding ExecutionModeDetail}" Style="{StaticResource Execution.StatSub}" FontFamily="{DynamicResource Font.Base}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="Net asset value across every book: opening equity, plus realized P&amp;L, plus open P&amp;L at the latest price.">
                        <StackPanel>
                            <TextBlock Text="NAV" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.NetAssetValue}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                            <TextBlock Text="{Binding Desk.BooksLine}" Style="{StaticResource Execution.StatSub}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="P&amp;L closed today (UTC), after fees.">
                        <StackPanel>
                            <TextBlock Text="REALIZED TODAY" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.DayRealized}" Tag="{Binding Desk.DayRealizedTone}" Style="{StaticResource Execution.StatValue}" />
                            <TextBlock Text="closed trades, after fees" Style="{StaticResource Execution.StatSub}" FontFamily="{DynamicResource Font.Base}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="What the open positions would make or lose if closed at the latest price.">
                        <StackPanel>
                            <TextBlock Text="OPEN P&amp;L" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.OpenProfitAndLoss}" Tag="{Binding Desk.OpenProfitAndLossTone}" Style="{StaticResource Execution.StatValue}" />
                            <TextBlock Text="at the latest price" Style="{StaticResource Execution.StatSub}" FontFamily="{DynamicResource Font.Base}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="Gross is the sum of every position's absolute market value; net sets longs against shorts. Leverage is gross over NAV.">
                        <StackPanel>
                            <TextBlock Text="GROSS / NET" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.GrossNet}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                            <TextBlock Text="{Binding Desk.Leverage}" Style="{StaticResource Execution.StatSub}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="One-day 95% value at risk: the loss on the worst 5% of days, from the desk's own daily P&amp;L. Reported once there are 20 active days.">
                        <StackPanel>
                            <TextBlock Text="VAR 95% · 1 DAY" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.ValueAtRisk}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                            <TextBlock Text="{Binding Desk.ValueAtRiskDetail}" Style="{StaticResource Execution.StatSub}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Execution.Stat}" ToolTip="Orders resting at a broker across every book.">
                        <StackPanel>
                            <TextBlock Text="WORKING ORDERS" Style="{StaticResource Execution.StatLabel}" />
                            <TextBlock Text="{Binding Desk.WorkingOrders}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                            <TextBlock Text="{Binding Desk.WorkingOrdersDetail}" Style="{StaticResource Execution.StatSub}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ═══ The desk: rail · book · ticket ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="304" />
            </Grid.ColumnDefinitions>

            <!-- ─── Left rail: connections and books ─────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10,5,10">

                    <!-- Connections: where orders can go. Restored 2026-09-26: the section that connected
                         broker cards went with the demo books on 2026-08-18 and left Connect, sign-in and the
                         LIVE switch bound to nothing. -->
                    <Border Style="{StaticResource Execution.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Style="{StaticResource Execution.CardHeader}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionsHeader}" Style="{StaticResource Execution.Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="CONNECTIONS" Style="{StaticResource Execution.SectionTitle}" />
                                </DockPanel>
                            </Border>

                            <Grid Margin="10,8,10,6">
                                <TextBox Text="{Binding ConnectionFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Find a broker by name or environment (demo, testnet, live)." />
                                <TextBlock Text="Find a broker…" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Execution.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ListBox ItemsSource="{Binding VisibleAdapters}"
                                     SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="264"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="9,6,10,6">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ExecutionAdapterReadModel}">
                                        <Grid ToolTip="{Binding StatusDetail}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource Execution.StatusDot}" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource Execution.Muted}" FontFamily="{DynamicResource Font.Data}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Tag="{Binding ChipTone}" Style="{StaticResource Execution.Chip}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ChipLabel}" Style="{StaticResource Execution.ChipText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="{Binding ShowAllConnectionsLabel}"
                                    Command="{Binding ToggleAllConnectionsCommand}"
                                    Style="{StaticResource Execution.LinkButton}"
                                    HorizontalAlignment="Left"
                                    Margin="6,2,0,6"
                                    Visibility="{Binding ShowAllConnectionsLabel, Converter={StaticResource StringToVisibilityConverter}}" />

                            <!-- The chosen connection: sign in, connect, and switch between its test environment and LIVE. -->
                            <Border BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,0" Padding="12,10,12,12"
                                    Visibility="{Binding HasSelectedAdapter, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseConnectionCommand}" Style="{StaticResource Execution.LinkButton}" Foreground="{DynamicResource Text.Secondary}" ToolTip="Close" />
                                        <TextBlock Text="{Binding SelectedAdapter.DisplayName}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Tag="{Binding SelectedAdapter.ChipTone}" Style="{StaticResource Execution.Chip}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedAdapter.ChipLabel}" Style="{StaticResource Execution.ChipText}" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedAdapter.StatusLabel}" Tag="{Binding SelectedAdapter.Tone}" Style="{StaticResource Execution.TagTone}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAdapter.StatusDetail}" Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16" />

                                    <ContentControl Content="{Binding SelectedAdapter.LoginForm}" Margin="0,8,0,0"
                                                    Visibility="{Binding SelectedAdapter.HasLoginForm, Converter={StaticResource BooleanToVisibility}}" />
                                    <TextBlock Text="{Binding SelectedAdapter.CredentialDetail}" Style="{StaticResource Execution.Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" />

                                    <!-- The configuration-bound (not routed) cards bind their exact execution account separately. -->
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedAdapter.LoginBroker}" Value="{x:Static brokers:BrokerKind.CTrader}" />
                                                            <Condition Binding="{Binding SelectedAdapter.IsRouted}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Exact cTrader execution account ID" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding CTraderExecutionAccountId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedAdapter.LoginBroker}" Value="{x:Static brokers:BrokerKind.InteractiveBrokers}" />
                                                            <Condition Binding="{Binding SelectedAdapter.IsRouted}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Exact Interactive Brokers execution account ID" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding InteractiveBrokersAccountId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAdapter.LoginBroker}" Value="{x:Static brokers:BrokerKind.Alpaca}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Expected Alpaca LIVE account ID" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding AlpacaLiveAccountId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Connect"
                                                Command="{Binding ConnectAdapterCommand}"
                                                CommandParameter="{Binding SelectedAdapter.Id}"
                                                IsEnabled="{Binding SelectedAdapter.CanConnect}"
                                                Style="{StaticResource Execution.PrimaryButton}"
                                                Margin="0,0,6,6"
                                                ToolTip="Signs in with the form above (saved encrypted for routed brokers) and reads the account." />
                                        <Button Content="Disconnect"
                                                Command="{Binding DisconnectAdapterCommand}"
                                                CommandParameter="{Binding SelectedAdapter.Id}"
                                                IsEnabled="{Binding SelectedAdapter.CanDisconnect}"
                                                Style="{StaticResource Execution.Button}"
                                                Margin="0,0,6,6" />
                                        <Button Content="{Binding SelectedAdapter.ModeSwitchLabel}"
                                                Command="{Binding SetExecutionModeCommand}"
                                                CommandParameter="{Binding SelectedAdapter}"
                                                IsEnabled="{Binding SelectedAdapter.CanChangeExecutionMode}"
                                                Style="{StaticResource Execution.WarningButton}"
                                                Margin="0,0,0,6"
                                                ToolTip="LIVE reads the account these credentials reach and asks you to type LIVE for that exact account. It also needs Execution:Routes:AllowLiveExecution and REAL armed in the login window." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Books: one strategy (or manual orders) on one account and instrument. -->
                    <Border Style="{StaticResource Execution.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Execution.CardHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="+ New book" Command="{Binding NewBookCommand}" Style="{StaticResource Execution.LinkButton}" />
                                    <TextBlock Text="BOOKS" Style="{StaticResource Execution.SectionTitle}" />
                                </DockPanel>
                            </Border>

                            <Border Padding="12,10" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,0,0,1"
                                    Visibility="{Binding IsNewBookOpen, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="New book" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="Name" Style="{StaticResource Execution.FieldLabel}" />
                                    <TextBox Text="{Binding NewBookName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                    <TextBlock Text="Mode" Style="{StaticResource Execution.FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AvailableBookModes}"
                                              SelectedItem="{Binding SelectedNewBookMode}"
                                              Margin="0,0,0,8"
                                              ToolTip="Paper keeps every order inside the application. Real routes to a connected broker account: its demo or testnet unless that card is LIVE." />
                                    <TextBlock Text="Broker account" Style="{StaticResource Execution.FieldLabel}"
                                               Visibility="{Binding NewBookNeedsBroker, Converter={StaticResource BooleanToVisibility}}" />
                                    <ComboBox ItemsSource="{Binding AvailableAdapters}"
                                              SelectedItem="{Binding SelectedNewBookAdapter}"
                                              Margin="0,0,0,8"
                                              Visibility="{Binding NewBookNeedsBroker, Converter={StaticResource BooleanToVisibility}}"
                                              ToolTip="Only connected accounts are offered. Connect one under Connections first.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource Execution.StatusDot}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding ChipLabel, StringFormat={}  ·  {0}}" Foreground="{DynamicResource Text.Secondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Strategy it copies" Style="{StaticResource Execution.FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AvailableStrategies}"
                                              SelectedItem="{Binding SelectedNewBookStrategy}"
                                              Margin="0,0,0,4"
                                              ToolTip="Authored and installed strategies. While the strategy's window runs, the book copies its position." />
                                    <TextBlock Style="{StaticResource Execution.Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="The book trades the instrument the strategy runs on. Any number of books can copy one strategy, each on its own account; one that cannot trade the strategy's instrument says why." />
                                    <TextBlock Text="Units per strategy unit" Style="{StaticResource Execution.FieldLabel}" />
                                    <TextBox Text="{Binding NewBookSize, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,9"
                                             ToolTip="The book's size. One unit of the strategy's position becomes this many of the book's own units: a share, a contract, or the broker's volume step (0.01 lot on cTrader, 0.00001 BTC on Binance)." />
                                    <TextBlock Text="{Binding NewBookError}"
                                               Visibility="{Binding NewBookError, Converter={StaticResource StringToVisibilityConverter}}"
                                               Foreground="{DynamicResource Bearish.Brush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelNewBookCommand}" Style="{StaticResource Execution.Button}" Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Content="Create" Command="{Binding CreateBookCommand}" Style="{StaticResource Execution.PrimaryButton}" Margin="4,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ListBox ItemsSource="{Binding BookEntries}"
                                     SelectedItem="{Binding SelectedBookEntry, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,0,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,0,0,1">
                                                        <Border x:Name="Marker" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="9,8,12,8">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                            <Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ExecutionBookNavigationReadModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProfitAndLoss}" Style="{StaticResource Execution.DataTone}" Tag="{Binding Tone}" FontSize="11.5" Margin="6,0,0,0"
                                                       ToolTip="Realized plus open P&amp;L since the book attached." />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Tag="{Binding Book.ModeTone}" Margin="0,0,5,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Execution.Chip}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAllBooks}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Book.ModeLabel}" Style="{StaticResource Execution.ChipText}" FontSize="8.5" />
                                                </Border>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Execution.Muted}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Position}" Style="{StaticResource Execution.MutedCell}" FontSize="10.5" HorizontalAlignment="Right" Margin="6,3,0,0" />
                                            <TextBlock Grid.Row="2" Text="{Binding Strategy}" Style="{StaticResource Execution.Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Alert}" Foreground="{DynamicResource Warning.Brush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="6,2,0,0"
                                                       Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Centre: the selected book, or all books ──────────────────────────────────── -->
            <Border Grid.Column="1" Style="{StaticResource Execution.Card}" Margin="5,10,5,10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Book header -->
                    <Border Grid.Row="0" Padding="14,11,14,10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBook}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Content="{Binding IntakeToggleLabel}"
                                        ContentStringFormat="{}{0} intake"
                                        Command="{Binding ToggleIntakeCommand}"
                                        IsEnabled="{Binding CanIssueCommands}"
                                        Style="{StaticResource Execution.WarningButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Stop or start new orders on this book. Working orders stay managed while stopped." />
                                <Button Content="Reconcile"
                                        Command="{Binding ReconcileCommand}"
                                        IsEnabled="{Binding CanIssueCommands}"
                                        Style="{StaticResource Execution.Button}"
                                        Margin="0,0,6,0"
                                        ToolTip="Compare the book with the broker now: orders, position and cash. A difference opens a case and blocks new orders until resolved." />
                                <Button Content="Kill book…"
                                        Command="{Binding KillCommand}"
                                        IsEnabled="{Binding CanKill}"
                                        Style="{StaticResource Execution.DangerButton}"
                                        ToolTip="Stops intake, cancels this book's working orders and flattens its position through its own broker. Asks first." />
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBookEntry.Name}" Foreground="{DynamicResource Text.Header}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <WrapPanel Margin="0,4,0,0">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedBook}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <Border Tag="{Binding SelectedBook.ModeTone}" Style="{StaticResource Execution.Chip}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedBook.ModeLabel}" Style="{StaticResource Execution.ChipText}" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedBookEntry.Detail}" Style="{StaticResource Execution.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="·" Style="{StaticResource Execution.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SelectedBookEntry.Strategy}" Style="{StaticResource Execution.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Tag="{Binding SelectedBook.AdmissionTone}" Style="{StaticResource Execution.Chip}" Margin="0,0,6,0"
                                            ToolTip="Whether the engine will take a new order now: intake on, lease held and reconciliation clean.">
                                        <TextBlock Text="{Binding SelectedBook.AdmissionLabel}" Style="{StaticResource Execution.ChipText}" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedBook.Lease.FenceLabel}" Style="{StaticResource Execution.Muted}" FontFamily="{DynamicResource Font.Data}" FontSize="10.5" VerticalAlignment="Center"
                                               ToolTip="The execution lease this book writes under. One writer per broker account, fenced." />
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedBookEntry.Detail}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Execution.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedBook}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- The book trades what its strategy trades; when its account cannot, say why. -->
                                <Border Margin="0,9,0,0" Padding="10,6" CornerRadius="5" BorderThickness="1"
                                        Background="{DynamicResource Warning.Soft}" BorderBrush="{DynamicResource Warning.Brush}"
                                        Visibility="{Binding SelectedBook.HasStrategyWarning, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warning.Brush}" FontSize="11.5" LineHeight="16">
                                        <Run Text="The selected strategy can't be used: " FontWeight="SemiBold" /><Run Text="{Binding SelectedBook.StrategyWarning, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Execution.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedBook.IsAwaitingInstrument}" Value="True" />
                                                        <Condition Binding="{Binding SelectedBook.HasStrategyWarning}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Waiting for " /><Run Text="{Binding SelectedBook.StrategySummary, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": open its window. The book trades the instrument the strategy runs on." />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tabs -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,1" Padding="6,0">
                        <WrapPanel>
                            <RadioButton Content="Overview" Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Overview}" />
                            <RadioButton Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Positions}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Positions" />
                                    <TextBlock Text="{Binding PositionCount}" Style="{StaticResource Execution.MutedCell}" FontSize="10.5" Margin="6,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Orders}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Orders" />
                                    <TextBlock Text="{Binding OpenOrderCount}" Style="{StaticResource Execution.MutedCell}" FontSize="10.5" Margin="6,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Fills}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fills" />
                                    <TextBlock Text="{Binding FillCount}" Style="{StaticResource Execution.MutedCell}" FontSize="10.5" Margin="6,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Content="Execution quality" Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Quality}" />
                            <RadioButton Content="Risk" Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Risk}" />
                            <RadioButton Style="{StaticResource Execution.Tab}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Audit}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Audit" />
                                    <Border Tag="{x:Static local:ExecutionTone.Warning}" Style="{StaticResource Execution.Chip}" Margin="6,0,0,0"
                                            Visibility="{Binding HasOpenReconciliation, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding OpenReconciliationCount}" Style="{StaticResource Execution.ChipText}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>
                    </Border>

                    <!-- ── Overview ─────────────────────────────────────────────────────────────── -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Overview}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="14,12,14,14">
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Execution.SegmentGroup}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="7D" Style="{StaticResource Execution.Segment}" IsChecked="{Binding SelectedRange, Converter={StaticResource Equals}, ConverterParameter=SevenDays}" />
                                        <RadioButton Content="30D" Style="{StaticResource Execution.Segment}" IsChecked="{Binding SelectedRange, Converter={StaticResource Equals}, ConverterParameter=ThirtyDays}" />
                                        <RadioButton Content="90D" Style="{StaticResource Execution.Segment}" IsChecked="{Binding SelectedRange, Converter={StaticResource Equals}, ConverterParameter=NinetyDays}" />
                                        <RadioButton Content="YTD" Style="{StaticResource Execution.Segment}" IsChecked="{Binding SelectedRange, Converter={StaticResource Equals}, ConverterParameter=YearToDate}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Execution.Explain}"
                                           Text="How the book is doing. Every figure comes from its own fills: a closed trade is a fill that reduced the position, net of both legs' fees. NAV and open P&amp;L are marked to the latest price; the range buttons change the period for the rest." />
                            </DockPanel>

                            <WrapPanel Margin="0,0,-8,4">
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Opening equity + realized + open P&amp;L.">
                                    <StackPanel>
                                        <TextBlock Text="NAV" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Selection.NetAssetValue}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding Selection.Realized, StringFormat=realized {0}}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Open positions at the latest price, against their average cost.">
                                    <StackPanel>
                                        <TextBlock Text="OPEN P&amp;L" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Selection.Unrealized}" Tag="{Binding Selection.UnrealizedTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="{Binding Selection.DayRealized, StringFormat={}{0} today}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Realized P&amp;L over the selected period.">
                                    <StackPanel>
                                        <TextBlock Text="NET P&amp;L" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.NetProfitAndLossDisplay}" Tag="{Binding Metrics.ProfitAndLossTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="{Binding Metrics.ReturnDisplay, StringFormat={}{0} return}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Mean daily return over its standard deviation, annualised with √252.">
                                    <StackPanel>
                                        <TextBlock Text="SHARPE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.SharpeDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="annualised, daily" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Mean daily return over downside deviation (losing days only), annualised.">
                                    <StackPanel>
                                        <TextBlock Text="SORTINO" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.SortinoDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="downside deviation" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="The deepest fall from a peak in equity during the period.">
                                    <StackPanel>
                                        <TextBlock Text="MAX DRAWDOWN" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.MaxDrawdownDisplay}" Tag="{Binding Metrics.DrawdownTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="peak to trough" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Annualised return over the depth of the worst drawdown.">
                                    <StackPanel>
                                        <TextBlock Text="CALMAR" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.CalmarDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="return ÷ max DD" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Share of closed trades that made money after fees.">
                                    <StackPanel>
                                        <TextBlock Text="WIN RATE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.WinRateDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding Metrics.TradesDisplay}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Money made on winning trades over money lost on losing ones. Above 1 makes money.">
                                    <StackPanel>
                                        <TextBlock Text="PROFIT FACTOR" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.ProfitFactorDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="gross win ÷ gross loss" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="What a closed trade makes on average, after fees.">
                                    <StackPanel>
                                        <TextBlock Text="EXPECTANCY" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.ExpectancyDisplay}" Tag="{Binding Metrics.ExpectancyTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="per closed trade" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Average winning trade / average losing trade. Payoff is their ratio.">
                                    <StackPanel>
                                        <TextBlock Text="AVG WIN / LOSS" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.AverageWinLossDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" FontSize="12.5" Margin="0,4,0,1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Metrics.PayoffDisplay}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="One-day 95% historical value at risk from this period's daily P&amp;L. Reported from 20 active days.">
                                    <StackPanel>
                                        <TextBlock Text="VAR 95% · 1 DAY" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.ValueAtRiskDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding Metrics.ValueAtRiskDetail}" Style="{StaticResource Execution.StatSub}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Gross exposure (the absolute market value of every position); net and leverage below.">
                                    <StackPanel>
                                        <TextBlock Text="EXPOSURE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Selection.GrossExposure}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Style="{StaticResource Execution.StatSub}">
                                            <Run Text="net " /><Run Text="{Binding Selection.NetExposure, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selection.Leverage, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Positions held now.">
                                    <StackPanel>
                                        <TextBlock Text="OPEN POSITIONS" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding Metrics.OpenPositionsDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding OpenOrderCount, StringFormat={}{0} working orders}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="190" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="78" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="12,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Metrics.NetProfitAndLossDisplay}" Tag="{Binding Metrics.ProfitAndLossTone}" Style="{StaticResource Execution.TagTone}" FontFamily="{DynamicResource Font.Data}" VerticalAlignment="Center" />
                                            <TextBlock Text="Cumulative realized P&amp;L" Style="{StaticResource Execution.SectionTitle}" />
                                        </DockPanel>
                                        <sp:WpfPlot x:Name="EquityPlot" Grid.Row="1" />
                                        <TextBlock Grid.Row="2" Text="Drawdown from peak" Style="{StaticResource Execution.Muted}" Margin="12,4,0,0" />
                                        <sp:WpfPlot x:Name="DrawdownPlot" Grid.Row="3" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="*" MinHeight="200" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Daily realized P&amp;L" Style="{StaticResource Execution.SectionTitle}" Margin="12,0" />
                                        <sp:WpfPlot x:Name="DailyPnlPlot" Grid.Row="1" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- All books: the breakdown and where the exposure sits. -->
                            <Grid Visibility="{Binding IsAllBooksSelected, Converter={StaticResource BooleanToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Books" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                                    <DataGrid ItemsSource="{Binding BookBreakdown}" Style="{StaticResource Execution.Grid}" MaxHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="BOOK" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource Execution.StatusDot}" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding BookName}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="EQUITY" Binding="{Binding Equity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="96" />
                                            <DataGridTemplateColumn Header="TODAY" Width="86">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DayProfitAndLoss}" Tag="{Binding DayProfitAndLossTone}" Style="{StaticResource Execution.DataTone}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="RETURN" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Return}" Tag="{Binding ReturnTone}" Style="{StaticResource Execution.DataTone}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="SHARPE" Binding="{Binding Sharpe}" ElementStyle="{StaticResource Execution.NumericCell}" Width="62" />
                                            <DataGridTextColumn Header="TRADES" Binding="{Binding Trades}" ElementStyle="{StaticResource Execution.NumericCell}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Exposure by book" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding ExposureByBook}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding BookName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Margin="6,0,3,0">
                                                        <TextBlock Text="{Binding LongDisplay}" Foreground="{DynamicResource Bullish.Brush}" FontFamily="{DynamicResource Font.Data}" FontSize="9.5" TextAlignment="Right" />
                                                        <ProgressBar Value="{Binding LongPercentage, Mode=OneWay}" Maximum="100" Height="6" Background="{DynamicResource Background.Elevated}" BorderThickness="0" Foreground="{DynamicResource Bullish.Brush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="3,0,6,0">
                                                        <TextBlock Text="{Binding ShortDisplay}" Foreground="{DynamicResource Bearish.Brush}" FontFamily="{DynamicResource Font.Data}" FontSize="9.5" />
                                                        <ProgressBar Value="{Binding ShortPercentage, Mode=OneWay}" Maximum="100" Height="6" Background="{DynamicResource Background.Elevated}" BorderThickness="0" Foreground="{DynamicResource Bearish.Brush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding NetDisplay}" Style="{StaticResource Execution.ToneText}" FontFamily="{DynamicResource Font.Data}" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Positions ───────────────────────────────────────────────────────────── -->
                    <DockPanel Grid.Row="2" Margin="14,12,14,14">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Positions}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Execution.Explain}"
                                   Text="What the book holds at the broker now, marked to the latest price. Units are the book's own (a share, a contract, the broker's volume step); quantity is the same in the broker's terms. Target is what the bound strategy wants held, and drift is what the next order will close." />
                        <DataGrid ItemsSource="{Binding Positions}" Style="{StaticResource Execution.Grid}" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="INSTRUMENT" Width="136">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Instrument}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Side}" Tag="{Binding SideTone}" Style="{StaticResource Execution.TagTone}" FontSize="10" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="BOOK" Binding="{Binding BookName}" Width="110" />
                                <DataGridTextColumn Header="UNITS" Binding="{Binding RealQuantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="72" />
                                <DataGridTextColumn Header="QUANTITY" Binding="{Binding NativeQuantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="120" />
                                <DataGridTextColumn Header="AVG PRICE" Binding="{Binding AveragePrice}" ElementStyle="{StaticResource Execution.NumericCell}" Width="96" />
                                <DataGridTextColumn Header="MARK" Binding="{Binding LastPrice}" ElementStyle="{StaticResource Execution.NumericCell}" Width="96" />
                                <DataGridTextColumn Header="MKT VALUE" Binding="{Binding MarketValue}" ElementStyle="{StaticResource Execution.NumericCell}" Width="110" />
                                <DataGridTemplateColumn Header="OPEN P&amp;L" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnrealizedProfitAndLoss}" Tag="{Binding UnrealizedTone}" Style="{StaticResource Execution.DataTone}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="REALIZED" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RealizedProfitAndLoss}" Tag="{Binding RealizedTone}" Style="{StaticResource Execution.DataTone}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="% NAV" Binding="{Binding PercentOfNav}" ElementStyle="{StaticResource Execution.NumericCell}" Width="72" />
                                <DataGridTextColumn Header="MODEL" Binding="{Binding ModelUnits}" ElementStyle="{StaticResource Execution.NumericCell}" Width="72" />
                                <DataGridTextColumn Header="TARGET" Binding="{Binding TargetQuantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="76" />
                                <DataGridTemplateColumn Header="DRIFT" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Delta}" FontFamily="{DynamicResource Font.Data}" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDivergence}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ── Orders ──────────────────────────────────────────────────────────────── -->
                    <DockPanel Grid.Row="2" Margin="14,12,14,14">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Orders}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Execution.Explain}"
                                   Text="Orders still working at the broker. Cancel one, or change its size and prices in place: a change passes the same risk check as a new order, and a broker that cannot replace refuses it." />

                        <!-- Modify: the chosen working order's new total quantity and prices. -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" Padding="12,10" Margin="0,10,0,0"
                                Visibility="{Binding IsModifying, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" Margin="0,0,0,8">
                                    <Run Text="Change " /><Run Text="{Binding ModifyingOrder.ClientOrderId, Mode=OneWay}" FontFamily="{DynamicResource Font.Data}" />
                                    <Run Text="{Binding ModifyingOrder.Side, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ModifyingOrder.OrderType, Mode=OneWay}" />
                                </TextBlock>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,6" Width="120">
                                        <TextBlock Text="Total units" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding ModifyQuantity, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}"
                                                 ToolTip="The order's new total size in book units, including what has already filled." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,6" Width="130" Visibility="{Binding ModifyHasLimit, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Limit price" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding ModifyLimitPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,6" Width="130" Visibility="{Binding ModifyHasStop, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Stop price" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding ModifyStopPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                        <Button Content="Send change" Command="{Binding ApplyModifyCommand}" Style="{StaticResource Execution.PrimaryButton}" Margin="0,0,6,0" />
                                        <Button Content="Close" Command="{Binding CancelModifyCommand}" Style="{StaticResource Execution.Button}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding OpenOrders}" Style="{StaticResource Execution.Grid}" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="136">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Content="Modify"
                                                        Command="{Binding DataContext.BeginModifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsOpen}"
                                                        Style="{StaticResource Execution.SmallButton}"
                                                        Margin="0,0,5,0"
                                                        ToolTip="Change this order's size or prices in place." />
                                                <Button Content="Cancel"
                                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsOpen}"
                                                        Style="{StaticResource Execution.SmallDangerButton}"
                                                        ToolTip="Cancel this working order through the book's guarded engine." />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PLACED (UTC)" Binding="{Binding Placed}" ElementStyle="{StaticResource Execution.MutedCell}" Width="124" />
                                <DataGridTextColumn Header="INSTRUMENT" Binding="{Binding Instrument}" Width="96" />
                                <DataGridTemplateColumn Header="SIDE" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Side}" Tag="{Binding SideTone}" Style="{StaticResource Execution.TagTone}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding OrderType}" Width="78" />
                                <DataGridTextColumn Header="TIF" Binding="{Binding TimeInForce}" Width="52" />
                                <DataGridTextColumn Header="UNITS" Binding="{Binding Quantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="68" />
                                <DataGridTextColumn Header="FILLED" Binding="{Binding Filled}" ElementStyle="{StaticResource Execution.NumericCell}" Width="68" />
                                <DataGridTextColumn Header="LIMIT" Binding="{Binding LimitPrice}" ElementStyle="{StaticResource Execution.NumericCell}" Width="90" />
                                <DataGridTextColumn Header="STOP" Binding="{Binding StopPrice}" ElementStyle="{StaticResource Execution.NumericCell}" Width="90" />
                                <DataGridTemplateColumn Header="STATE" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Execution.ToneText}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100" />
                                <DataGridTextColumn Header="AGE" Binding="{Binding Age}" ElementStyle="{StaticResource Execution.NumericCell}" Width="56" />
                                <DataGridTextColumn Header="ORDER" Binding="{Binding ClientOrderId}" ElementStyle="{StaticResource Execution.MutedCell}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ── Fills ───────────────────────────────────────────────────────────────── -->
                    <DockPanel Grid.Row="2" Margin="14,12,14,14">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Fills}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Execution.Explain}"
                                   Text="Every fill the broker reported, newest first. 'At send' is the price the order was sent against (the price its risk check used); slippage is the fill against it in basis points, positive when it cost you. Realized is what a fill that reduced the position made, after fees." />
                        <DataGrid ItemsSource="{Binding Fills}" Style="{StaticResource Execution.Grid}" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Time}" ElementStyle="{StaticResource Execution.MutedCell}" Width="150" />
                                <DataGridTextColumn Header="BOOK" Binding="{Binding BookName}" Width="110" />
                                <DataGridTextColumn Header="INSTRUMENT" Binding="{Binding Instrument}" Width="96" />
                                <DataGridTemplateColumn Header="SIDE" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Side}" Tag="{Binding SideTone}" Style="{StaticResource Execution.TagTone}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="UNITS" Binding="{Binding Units}" ElementStyle="{StaticResource Execution.NumericCell}" Width="68" />
                                <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="120" />
                                <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" ElementStyle="{StaticResource Execution.NumericCell}" Width="96" />
                                <DataGridTextColumn Header="AT SEND" Binding="{Binding ArrivalPrice}" ElementStyle="{StaticResource Execution.NumericCell}" Width="96" />
                                <DataGridTemplateColumn Header="SLIPPAGE" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Slippage}" Tag="{Binding SlippageTone}" Style="{StaticResource Execution.DataTone}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="FEE" Binding="{Binding Fee}" ElementStyle="{StaticResource Execution.NumericCell}" Width="80" />
                                <DataGridTemplateColumn Header="REALIZED" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RealizedProfitAndLoss}" Tag="{Binding RealizedTone}" Style="{StaticResource Execution.DataTone}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100" />
                                <DataGridTextColumn Header="BROKER ORDER" Binding="{Binding BrokerOrderId}" ElementStyle="{StaticResource Execution.MutedCell}" Width="170" />
                                <DataGridTextColumn Header="ORDER" Binding="{Binding ClientOrderId}" ElementStyle="{StaticResource Execution.MutedCell}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ── Execution quality ───────────────────────────────────────────────────── -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Quality}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="14,12,14,14">
                            <TextBlock Style="{StaticResource Execution.Explain}"
                                       Text="How well orders are being worked: how many fill, how fast the broker acknowledges them, and what they cost against the price at send. Implementation shortfall is that cost in money across every measured fill, plus fees." />
                            <WrapPanel Margin="0,0,-8,4">
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="FILL RATE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.FillRateDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding ExecutionQuality.OrdersDetail}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="REJECT RATE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.RejectRateDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding ExecutionQuality.Rejects, StringFormat={}{0} refused}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="CANCEL RATE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.CancelRateDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding ExecutionQuality.Cancels, StringFormat={}{0} cancel requests}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Average fill against the price at send; positive is a cost.">
                                    <StackPanel>
                                        <TextBlock Text="AVG SLIPPAGE" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.AverageSlippageBasisPointsDisplay}" Tag="{Binding ExecutionQuality.SlippageTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="{Binding ExecutionQuality.FillsDetail}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Time from sending an order to the broker accepting it.">
                                    <StackPanel>
                                        <TextBlock Text="AVG ACK" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.AverageAcknowledgementDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="send → accepted" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="Fills against the price at send, in money, plus fees. Positive is a cost.">
                                    <StackPanel>
                                        <TextBlock Text="IMPL. SHORTFALL" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.ImplementationShortfallDisplay}" Tag="{Binding ExecutionQuality.ImplementationShortfallTone}" Style="{StaticResource Execution.StatValue}" />
                                        <TextBlock Text="cost vs price at send" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="FEES" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.FeesDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="{Binding ExecutionQuality.FeesDetail}" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}" ToolTip="The money value of everything filled.">
                                    <StackPanel>
                                        <TextBlock Text="TURNOVER" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.TurnoverDisplay}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="filled notional" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="RECON CASES" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.ReconciliationCases}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="material differences" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Execution.Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="UNKNOWN" Style="{StaticResource Execution.StatLabel}" />
                                        <TextBlock Text="{Binding ExecutionQuality.UnknownOutcomes}" Style="{StaticResource Execution.StatValue}" Foreground="{DynamicResource Text.Header}" />
                                        <TextBlock Text="outcome never confirmed" Style="{StaticResource Execution.StatSub}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <Border Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" ClipToBounds="True" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="210" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="12,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecutionQuality.FillsDetail}" Style="{StaticResource Execution.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Slippage per fill (bps)" Style="{StaticResource Execution.SectionTitle}" />
                                    </DockPanel>
                                    <sp:WpfPlot x:Name="SlippagePlot" Grid.Row="1" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Risk ────────────────────────────────────────────────────────────────── -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Risk}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="14,12,14,14">
                            <TextBlock Style="{StaticResource Execution.Explain}"
                                       Text="The limits every order is checked against before it leaves, and the most of each this book has used. An order that would breach one is refused before it reaches the broker." />
                            <ItemsControl ItemsSource="{Binding RiskUsage}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" Width="250" Padding="12,10" Margin="0,0,10,10">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Execution.Data}" FontSize="11.5" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0" BorderThickness="0" Background="{DynamicResource Background.Elevated}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Positive}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Bullish.Brush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Warning}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static local:ExecutionTone.Negative}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Bearish.Brush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding Percentage, StringFormat={}{0:0}% of the limit used at most}" Style="{StaticResource Execution.Muted}" FontSize="10.5" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RiskEscalation}" Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding RiskEscalation, Converter={StaticResource StringToVisibilityConverter}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Execution.Card}" Background="{DynamicResource Background.Primary}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Exposure by book" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding ExposureByBook}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding NetDisplay}" Style="{StaticResource Execution.ToneText}" FontFamily="{DynamicResource Font.Data}" />
                                                        <TextBlock Text="{Binding BookName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource Background.Primary}" Padding="12,10">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Execution.Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedBook}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="This book's safety state" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Text="Execution lease" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBook.ServiceStatus}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="2" Text="Admission" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBook.AdmissionLabel}" Tag="{Binding SelectedBook.AdmissionTone}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="3" Text="Reference price" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TicketPriceLine}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="4" Text="One unit" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedBook.Unit.UnitLabel}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="5" Text="Mode" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedBook.ModeLabel}" Tag="{Binding SelectedBook.ModeTone}" Style="{StaticResource Execution.KeyValueValue}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Audit ───────────────────────────────────────────────────────────────── -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:ExecutionDetailTab.Audit}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="14,12,14,14">
                            <TextBlock Style="{StaticResource Execution.Explain}"
                                       Text="Where the book and the broker disagree, every order event, and the hash-chained ledger they are written to. An open reconciliation case blocks new orders on its book until it is resolved; Reconcile runs the comparison again." />

                            <TextBlock Text="Reconciliation cases" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="None: the book and the broker agree." Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Execution.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReconciliationCases.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding ReconciliationCases}" MaxHeight="190" Margin="0,0,0,14">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource Execution.Grid}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReconciliationCases.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="150" />
                                    <DataGridTemplateColumn Header="CASE" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type}" Style="{StaticResource Execution.ToneText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*" />
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox Text="{Binding HistoryInstrumentFilter, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"
                                             ToolTip="Filter by instrument or book." />
                                    <DatePicker SelectedDate="{Binding HistoryFromDate}" Width="118" Margin="0,0,6,0" ToolTip="From" />
                                    <DatePicker SelectedDate="{Binding HistoryToDate}" Width="118" ToolTip="To" />
                                </StackPanel>
                                <TextBlock Text="Order events" Style="{StaticResource Execution.SectionTitle}" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding FilteredHistory}" Style="{StaticResource Execution.Grid}" MaxHeight="300" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding Date}" ElementStyle="{StaticResource Execution.MutedCell}" Width="84" />
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" ElementStyle="{StaticResource Execution.MutedCell}" Width="66" />
                                    <DataGridTextColumn Header="BOOK" Binding="{Binding BookName}" Width="90" />
                                    <DataGridTextColumn Header="INSTRUMENT" Binding="{Binding Instrument}" Width="90" />
                                    <DataGridTemplateColumn Header="EVENT" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Event}" Style="{StaticResource Execution.ToneText}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*" />
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" ElementStyle="{StaticResource Execution.NumericCell}" Width="60" />
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" ElementStyle="{StaticResource Execution.NumericCell}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Ledger (hash-chained)" Style="{StaticResource Execution.SectionTitle}" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding LedgerEvents}" Style="{StaticResource Execution.Grid}" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Timestamp}" ElementStyle="{StaticResource Execution.MutedCell}" Width="100" />
                                    <DataGridTemplateColumn Header="EVENT" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Execution.ToneText}" FontFamily="{DynamicResource Font.Data}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="HASH" Binding="{Binding Hash}" ElementStyle="{StaticResource Execution.MutedCell}" Width="96" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty state: a fresh desk has no books. What to do, in order. Covers the centre only,
                         so Connections and "+ New book" stay reachable. -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10" Background="{DynamicResource Background.Surface}" CornerRadius="7"
                            Visibility="{Binding HasBooks, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                            <TextBlock Text="Set up the desk" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Header}" />
                            <TextBlock Style="{StaticResource Execution.Explain}" Margin="0,6,0,16"
                                       Text="A book is a name, an account and the strategy it copies; it trades the instrument that strategy runs on. Every order it sends passes intake, reconciliation, risk and the lease; nothing here is simulated or seeded." />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="1" Foreground="{DynamicResource Accent.Brush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Connect a broker — or skip it for Paper" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Under Connections on the left, pick the broker's demo or testnet card, sign in with the form it shows, and press Connect. Paper books need no broker." />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="2" Foreground="{DynamicResource Accent.Brush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Create a book" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="+ New book: a name, Paper or Real on the connected account, the strategy it copies, and its size. Any number of books can copy one strategy." />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="3" Foreground="{DynamicResource Accent.Brush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Trade it" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Open the strategy's window: the book binds to its instrument and copies its position, scaled by the book's size. From then on the ticket on the right trades it by hand too." />
                                </StackPanel>
                            </Grid>
                            <Button Content="+ New book" Command="{Binding NewBookCommand}" Style="{StaticResource Execution.PrimaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── Right dock: act on the selected book ─────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="5,10,10,10">

                    <!-- Order ticket: one order by hand, through the same guarded engine a strategy's targets use. -->
                    <Border Style="{StaticResource Execution.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Style="{StaticResource Execution.CardHeader}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Tag="{Binding SelectedBook.ModeTone}" Style="{StaticResource Execution.Chip}"
                                            Visibility="{Binding HasTicketBook, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding SelectedBook.ModeLabel}" Style="{StaticResource Execution.ChipText}" />
                                    </Border>
                                    <TextBlock Text="ORDER TICKET" Style="{StaticResource Execution.SectionTitle}" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Select a book that trades an instrument to send an order."
                                       Style="{StaticResource Execution.Muted}" TextWrapping="Wrap" Margin="12,12,12,14"
                                       Visibility="{Binding HasTicketBook, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <StackPanel Margin="12,10,12,12" Visibility="{Binding HasTicketBook, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding SelectedBookEntry.Name}" Foreground="{DynamicResource Text.Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TicketInstrumentLabel}" Style="{StaticResource Execution.Muted}" />
                                <TextBlock Text="{Binding TicketPriceLine}" Style="{StaticResource Execution.MutedCell}" FontSize="11" Margin="0,2,0,10" />

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <RadioButton Style="{StaticResource Execution.SideButton}" Tag="{DynamicResource Bullish.Brush}" Margin="0,0,3,0"
                                                 IsChecked="{Binding TicketSide, Converter={StaticResource Equals}, ConverterParameter=Buy}">
                                        <TextBlock Text="BUY" FontWeight="Bold" FontSize="13" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Execution.SideButton}" Tag="{DynamicResource Bearish.Brush}" Margin="3,0,0,0"
                                                 IsChecked="{Binding TicketSide, Converter={StaticResource Equals}, ConverterParameter=Sell}">
                                        <TextBlock Text="SELL" FontWeight="Bold" FontSize="13" />
                                    </RadioButton>
                                </UniformGrid>

                                <TextBlock Text="Quantity · book units" Style="{StaticResource Execution.FieldLabel}" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−" Command="{Binding StepTicketQuantityCommand}" CommandParameter="-1" Style="{StaticResource Execution.Button}" Padding="0,3" ToolTip="One unit fewer" />
                                    <TextBox Grid.Column="1" Text="{Binding TicketQuantity, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0"
                                             ToolTip="Whole book units: a share, a contract, or the broker's volume step." />
                                    <Button Grid.Column="2" Content="+" Command="{Binding StepTicketQuantityCommand}" CommandParameter="1" Style="{StaticResource Execution.Button}" Padding="0,3" ToolTip="One unit more" />
                                </Grid>
                                <TextBlock Text="{Binding TicketNativeHint}" Style="{StaticResource Execution.MutedCell}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="Order type" Style="{StaticResource Execution.FieldLabel}" />
                                <Border Style="{StaticResource Execution.SegmentGroup}" Margin="0,0,0,10">
                                    <UniformGrid Columns="4">
                                        <RadioButton Content="Market" Style="{StaticResource Execution.Segment}" IsChecked="{Binding TicketType, Converter={StaticResource Equals}, ConverterParameter=Market}" />
                                        <RadioButton Content="Limit" Style="{StaticResource Execution.Segment}" IsChecked="{Binding TicketType, Converter={StaticResource Equals}, ConverterParameter=Limit}" />
                                        <RadioButton Content="Stop" Style="{StaticResource Execution.Segment}" IsChecked="{Binding TicketType, Converter={StaticResource Equals}, ConverterParameter=Stop}" />
                                        <RadioButton Content="Stop lmt" Style="{StaticResource Execution.Segment}" IsChecked="{Binding TicketType, Converter={StaticResource Equals}, ConverterParameter=StopLimit}" />
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,0,0,10" Visibility="{Binding TicketNeedsPrices, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Visibility="{Binding TicketNeedsLimit, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Limit" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding TicketLimitPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding TicketNeedsStop, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Stop" Style="{StaticResource Execution.FieldLabel}" />
                                        <TextBox Text="{Binding TicketStopPrice, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Data}" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{DynamicResource Border.Strong}" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Notional" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TicketNotional}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="1" Text="Share of NAV" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TicketNavShare}" Style="{StaticResource Execution.KeyValueValue}" />
                                        <TextBlock Grid.Row="2" Text="Position" Style="{StaticResource Execution.KeyValueKey}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TicketPositionAfter}" Style="{StaticResource Execution.KeyValueValue}" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding TicketChecks}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ExecutionTicketCheck}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Tag="{Binding Tone}" Style="{StaticResource Execution.TagTone}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Command="{Binding SubmitTicketCommand}" Padding="10,9"
                                        ToolTip="Pause, reconciliation, risk, the lease and the Paper/Real gates all apply. A LIVE book asks first.">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Execution.Button}">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Background" Value="{DynamicResource Bullish.Brush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Bullish.Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TicketIsBuy}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Bearish.Brush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Bearish.Brush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding TicketSubmitLabel}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <TextBlock Text="{Binding TicketMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0"
                                           Visibility="{Binding TicketMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Strategy link: the running strategy the book copies. -->
                    <Border Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Execution.Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBook}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Border Style="{StaticResource Execution.CardHeader}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Tag="{Binding SelectedBook.StrategyLink.StatusTone}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Execution.Chip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedBook.StrategyLink}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedBook.StrategyLink.Status}" Style="{StaticResource Execution.ChipText}" />
                                    </Border>
                                    <TextBlock Text="STRATEGY LINK" Style="{StaticResource Execution.SectionTitle}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Manual only: this book copies no strategy. Create a book with a strategy to have a running strategy window trade it."
                                       TextWrapping="Wrap" Margin="12,10,12,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Execution.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBook.StrategyLink}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="12,8,12,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBook.StrategyLink}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Strategy" Style="{StaticResource Execution.KeyValueKey}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedBook.StrategyLink.Strategy}" Style="{StaticResource Execution.KeyValueValue}" FontFamily="{DynamicResource Font.Base}" />
                                    <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Execution.KeyValueKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBook.UnitsPerStrategyUnit, StringFormat=×{0:N0} units per strategy unit}" Style="{StaticResource Execution.KeyValueValue}" />
                                    <TextBlock Grid.Row="2" Text="Last target" Style="{StaticResource Execution.KeyValueKey}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBook.StrategyLink.LastTargetDisplay}" Style="{StaticResource Execution.KeyValueValue}" />
                                    <TextBlock Grid.Row="3" Text="At" Style="{StaticResource Execution.KeyValueKey}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBook.StrategyLink.LastAtDisplay}" Style="{StaticResource Execution.KeyValueValue}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedBook.StrategyLink.LastOutcome}" Tag="{Binding SelectedBook.StrategyLink.OutcomeTone}" Style="{StaticResource Execution.TagTone}"
                                           TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ Status bar ═════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Background.Surface}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionSummary}" Style="{StaticResource Execution.Muted}" FontSize="10.5" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OperationMessage}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           ToolTip="{Binding OperationMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
