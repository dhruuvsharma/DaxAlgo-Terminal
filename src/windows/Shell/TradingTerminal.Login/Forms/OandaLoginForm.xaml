<UserControl x:Class="TradingTerminal.App.Login.Forms.OandaLoginForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="500">
    <StackPanel>
        <TextBlock Text="Account ID" Margin="0,0,0,4" />
        <TextBox Text="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}"
                 mah:TextBoxHelper.Watermark="001-001-1234567-001"
                 Margin="0,0,0,12" />

        <TextBlock Text="Personal access token" Margin="0,0,0,4" />
        <PasswordBox x:Name="TokenBox"
                     PasswordChanged="TokenBox_PasswordChanged"
                     mah:TextBoxHelper.Watermark="Stored DPAPI-encrypted on this machine"
                     Margin="0,0,0,12" />

        <CheckBox Content="Practice account (fxTrade Practice) - untick for live"
                  IsChecked="{Binding Practice}"
                  Margin="0,0,0,8" />

        <Border Background="{DynamicResource Background.Surface}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="1"
                Padding="10,6"
                Margin="0,4,0,0">
            <TextBlock TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource Text.Secondary}">
                <Run FontWeight="SemiBold" Text="Heads up:" />
                <Run Text="generate the token under Manage API Access in OANDA's account hub. The account ID is required - every v20 request is account-scoped, pricing included - and both must belong to the same environment as the box above." />
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
