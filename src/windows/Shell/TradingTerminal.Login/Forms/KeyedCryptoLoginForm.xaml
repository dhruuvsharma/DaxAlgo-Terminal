<UserControl x:Class="TradingTerminal.App.Login.Forms.KeyedCryptoLoginForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">
    <!-- One view for the six keyed crypto rows (Binance, Bybit, Coinbase, Kraken, OKX, Deribit). They ask
         for the same shape - a key, a secret, OKX's passphrase - and differ only in what each venue
         calls the fields, which the view-model supplies. -->
    <UserControl.Resources>
        <!-- Local, not the window's: this control is built in code and runs InitializeComponent before
             it has a parent, so a StaticResource defined on the login window would not resolve. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding WhereToGetAKey}"
                   TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Text.Primary}"
                   Margin="0,0,0,10" />

        <TextBlock Text="{Binding KeyLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="KeyBox"
                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                 mah:TextBoxHelper.Watermark="Paste from the venue's API page"
                 Margin="0,0,0,12" />

        <TextBlock Text="{Binding SecretLabel}" Margin="0,0,0,4" />
        <PasswordBox x:Name="SecretBox"
                     PasswordChanged="SecretBox_PasswordChanged"
                     mah:TextBoxHelper.Watermark="Stored DPAPI-encrypted on this machine"
                     Visibility="{Binding UsesSharedSecret, Converter={StaticResource BoolToVisibility}}"
                     Margin="0,0,0,12" />
        <!-- The PEM gets a multi-line box, unmasked: a single-line input keeps only the first line of a
             paste, which turns a PEM into its BEGIN line and nothing else. -->
        <TextBox x:Name="PemBox"
                 Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding UsesPrivateKeyPem, Converter={StaticResource BoolToVisibility}}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="11"
                 Height="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 mah:TextBoxHelper.Watermark="-----BEGIN EC PRIVATE KEY----- &#x2026; -----END EC PRIVATE KEY-----"
                 Margin="0,0,0,12" />

        <StackPanel Visibility="{Binding UsesPassphrase, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Passphrase" Margin="0,0,0,4" />
            <PasswordBox x:Name="PassphraseBox"
                         PasswordChanged="PassphraseBox_PasswordChanged"
                         mah:TextBoxHelper.Watermark="The passphrase set for this key - not your account password"
                         Margin="0,0,0,12" />
        </StackPanel>

        <Border Background="{DynamicResource Background.Surface}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="1"
                Padding="10,6">
            <TextBlock TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource Text.Secondary}">
                <Run FontWeight="SemiBold" Text="What happens on Connect:" />
                <Run Text="the key is checked with one signed, read-only balance call, then stored encrypted on this machine. Market data is the same public feed as the keyless row, and if the keyless row is already connected this takes that connection over - no reconnect. No orders are placed." />
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
