<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paper / Real trading switch.

        A wide sliding track with both destinations written on it, because this control decides
        whether orders reach real money and a plain checkbox does not carry that weight. The knob
        rests over the side that is ACTIVE, so the current mode is readable at a glance rather than
        inferred from a tick.

        The surface is Hyperion's own: Background.Elevated under Gradient.AiGlass, with Border.Strong
        and Hyperion's 14px radius (HYP.Radius.L, inlined so this dictionary resolves standalone) — the same stack the composer (chat box) is built from, used
        directly rather than approximated, so the two read as one design.

        The glass is deliberately colour-neutral, so the live-money signal is carried by the KNOB
        instead of the track: calm blue while Paper, red while Real. Losing that signal entirely was
        the one thing not worth trading for the look — the knob is the element the eye follows, so it
        is the right place for it.

        Arming Real is still gated: the command raises a typed confirmation, and IsChecked binds
        one-way to the real mode, so the knob only moves once the mode actually changed. A cancelled
        confirmation leaves it where it was.
    -->
    <Style x:Key="App.TradingModeToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- WPF's default focus visual is a rectangle around the control's bounds, which on a rounded
             control reads as a stray blue box. Focus is shown on the track instead, below. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- The Hyperion composer surface, used directly. -->
                        <Border x:Name="Track"
                                CornerRadius="14"
                                Background="{DynamicResource Background.Elevated}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />
                        <Border CornerRadius="14"
                                Background="{DynamicResource Gradient.AiGlass}"
                                IsHitTestVisible="False" />

                        <!-- Sliding knob. Carries the mode colour, since the glass is neutral. -->
                        <Border x:Name="Knob"
                                Width="114" Height="30"
                                CornerRadius="11"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0"
                                Background="#2F6BD4">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="KnobGlow" Color="#2F6BD4" BlurRadius="14"
                                                  ShadowDepth="0" Opacity="0.5" />
                            </Border.Effect>
                        </Border>

                        <!-- Both destinations, always readable, in their own halves. -->
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PaperLabel" Grid.Column="0" Text="PAPER"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                            <TextBlock x:Name="RealLabel" Grid.Column="1" Text="REAL"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="12" Foreground="#8C9AB3" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="120" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Knob"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#C02626" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="KnobGlow"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#C02626" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Knob"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#2F6BD4" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="KnobGlow"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#2F6BD4" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="PaperLabel" Property="Foreground" Value="#8C9AB3" />
                            <Setter TargetName="RealLabel" Property="Foreground" Value="#FFFFFF" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Accent.Brush}" />
                        </Trigger>

                        <!-- Keyboard focus only: thickens the track's own border, so tabbing is
                             visible without painting a box around the control. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
