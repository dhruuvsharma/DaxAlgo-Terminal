<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uic="clr-namespace:TradingTerminal.UI.Controls">

    <!--
        Shared sliding two-state switch.

        A wide track with both destinations written on it and the knob resting over the active one,
        so the current state is readable at a glance rather than inferred from a tick. Used where a
        checkbox would understate the choice.

        The surface is Hyperion's own: Background.Elevated under Gradient.AiGlass, Border.Strong, and
        Hyperion's 14px radius (HYP.Radius.L, inlined so this dictionary resolves standalone) — the
        same stack HYP.ComposerShell is built from, used directly rather than approximated, so the
        two read as one design.

        The glass is colour-neutral, so state is carried by the KNOB, which crossfades between two
        filled layers. Crossfading rather than animating a colour is what lets callers pass theme
        brushes: a ColorAnimation cannot animate to a bound value.

        Labels and accents come from uic:SlideToggle attached properties — see App.TradingModeToggle
        and App.AuthoringKindToggle below for how a caller specialises it.
    -->
    <Style x:Key="App.SlideToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- WPF's default focus visual is a rectangle around the control's bounds, which on a rounded
             control reads as a stray blue box. Focus is shown on the track instead, below. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- The Hyperion composer surface, used directly. -->
                        <Border x:Name="Track"
                                CornerRadius="14"
                                Background="{DynamicResource Background.Elevated}"
                                BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />
                        <Border CornerRadius="14"
                                Background="{DynamicResource Gradient.AiGlass}"
                                IsHitTestVisible="False" />

                        <!-- Sliding knob. Two filled layers crossfaded, so the accents can be bound. -->
                        <Grid x:Name="Knob"
                              Width="117" Height="30"
                              HorizontalAlignment="Left"
                              Margin="3,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="LeftFill" CornerRadius="11"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                         Path=(uic:SlideToggle.LeftAccent)}" />
                            <Border x:Name="RightFill" CornerRadius="11" Opacity="0"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                         Path=(uic:SlideToggle.RightAccent)}" />
                        </Grid>

                        <!-- Both destinations, always readable, in their own halves. -->
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LeftLabel" Grid.Column="0"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                      Path=(uic:SlideToggle.LeftLabel)}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                            <TextBlock x:Name="RightLabel" Grid.Column="1"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                      Path=(uic:SlideToggle.RightLabel)}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="12" Foreground="#8C9AB3" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="117" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RightFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LeftFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RightFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LeftFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="LeftLabel" Property="Foreground" Value="#8C9AB3" />
                            <Setter TargetName="RightLabel" Property="Foreground" Value="#FFFFFF" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Accent.Brush}" />
                        </Trigger>

                        <!-- Keyboard focus only: thickens the track's own border, so tabbing is
                             visible without painting a box around the control. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Paper / Real trading.

        Calm blue on the safe end, red on the end that spends money — the colour has to agree with
        the meaning. Arming Real is gated: the command raises a typed confirmation, and IsChecked
        binds one-way to the real mode, so the knob moves only once the mode actually changed. A
        cancelled confirmation leaves it where it was.
    -->
    <Style x:Key="App.TradingModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource App.SlideToggle}">
        <Setter Property="uic:SlideToggle.LeftLabel" Value="PAPER" />
        <Setter Property="uic:SlideToggle.RightLabel" Value="REAL" />
        <Setter Property="uic:SlideToggle.LeftAccent" Value="#2F6BD4" />
        <Setter Property="uic:SlideToggle.RightAccent" Value="#C02626" />
    </Style>

    <!--
        Strategy / Visualizer — what Hyperion is being asked to author.

        Takes the catalog's own kind colours rather than inventing a pair: a strategy card carries the
        AI purple and a visualizer card the accent blue, so the switch and the card that results from
        it agree on what each kind looks like.
    -->
    <Style x:Key="App.AuthoringKindToggle" TargetType="ToggleButton" BasedOn="{StaticResource App.SlideToggle}">
        <!-- Same 240x38 as the trading switch, deliberately: the knob travel is a constant in the
             shared template, and a Storyboard's To cannot bind to a per-style value. One size also
             keeps the two switches looking like the same control, which they are. -->
        <Setter Property="uic:SlideToggle.LeftLabel" Value="STRATEGY" />
        <Setter Property="uic:SlideToggle.RightLabel" Value="VISUALIZER" />
        <Setter Property="uic:SlideToggle.LeftAccent" Value="{DynamicResource Ai.Glow.Brush}" />
        <Setter Property="uic:SlideToggle.RightAccent" Value="{DynamicResource Accent.Brush}" />
    </Style>

</ResourceDictionary>
