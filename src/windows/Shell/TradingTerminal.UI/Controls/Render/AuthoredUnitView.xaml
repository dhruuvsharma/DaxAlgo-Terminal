<UserControl x:Class="TradingTerminal.UI.Controls.Render.AuthoredUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:render="clr-namespace:TradingTerminal.UI.Controls.Render"
             Background="{DynamicResource Background.Primary}">

    <!--
        The window body shared by authored strategies and visualizers.

        Parameters on top, the AUTHOR'S OWN PICTURE in the middle, then the virtual book and the
        activity log. The author draws the middle and nothing else: the chrome is host-owned, so it
        looks the same for every unit and cannot be omitted or got wrong — and Hyperion never has to
        generate it.

        The book row is the only difference between a strategy and a visualizer, which is the whole
        point: the difference is a capability, not a different kind of window.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- parameters -->
            <RowDefinition Height="*" />     <!-- the author's picture -->
            <RowDefinition Height="Auto" />  <!-- virtual book, strategies only -->
            <RowDefinition Height="Auto" />  <!-- activity log -->
        </Grid.RowDefinitions>

        <!--
            Parameters. Hidden when the unit declares none, which is what makes a visualizer's window
            the log-only shape asked for: a strategy always has parameters so it always shows, and a
            visualizer usually has none so it usually does not. Keyed off what the unit actually
            declares rather than off its kind, so a visualizer that DOES take parameters still shows
            them instead of having them silently swallowed.
        -->
        <Expander Grid.Row="0"
                  Visibility="{Binding HasParameters, Converter={StaticResource B2V}, FallbackValue=Collapsed}"
                  IsExpanded="{Binding IsSetupExpanded, Mode=TwoWay}"
                  Background="{DynamicResource Background.Elevated}"
                  BorderBrush="{DynamicResource Border.Brush}"
                  BorderThickness="0,0,0,1"
                  Padding="12,8">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  PARAMETERS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,8,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!--
            The author's picture. One panel by default; a unit that declares a UnitLayout gets that
            tree built into real panels with headers and draggable separators.
        -->
        <render:AuthoredUnitLayoutHost x:Name="Body" Grid.Row="1"
                                       Layout="{Binding Layout}"
                                       Draw="{Binding Draw}" />

        <!-- ── Virtual book (strategies only) ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="{Binding HasBook, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BOOK" FontWeight="Bold" FontSize="9.5"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock FontSize="11" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center">
                    <Run Text="Position" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.PositionUnits, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   @ " Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.AverageEntryPrice, Mode=OneWay, StringFormat=N4}" />
                    <Run Text="   Realised" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.RealizedProfitAndLoss, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   Equity" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.Equity, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   Resting" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.OpenOrders, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Activity log ───────────────────────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                MaxHeight="140">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="10,6">
                <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource Text.Secondary}">
                                <Run Text="{Binding TimestampUtc, Mode=OneWay, StringFormat=HH\:mm\:ss}" />
                                <Run Text="{Binding Source, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent.Brush}" />
                                <Run Text="{Binding Message, Mode=OneWay}"
                                     Foreground="{DynamicResource Text.Primary}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
