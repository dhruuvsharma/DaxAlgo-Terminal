<UserControl x:Class="TradingTerminal.UI.Controls.Render.AuthoredUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:render="clr-namespace:TradingTerminal.UI.Controls.Render"
             Background="{DynamicResource Background.Primary}">

    <!--
        The window body shared by authored strategies and visualizers.

        Parameters on top, the AUTHOR'S OWN PICTURE in the middle, then the virtual book and the
        activity log. The author draws the middle and nothing else: the chrome is host-owned, so it
        looks the same for every unit and cannot be omitted or got wrong — and Hyperion never has to
        generate it.

        The book row is the only difference between a strategy and a visualizer, which is the whole
        point: the difference is a capability, not a different kind of window.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!--
            One parameter. Editable when the host can apply it, which is the difference between a
            trading tool and a screenshot: changing a look-back and watching the picture move is the
            most common thing anyone does with one of these, and it was the one thing this window
            could not do.
        -->
        <DataTemplate x:Key="ParameterRow">
            <Grid Margin="0,3" ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Secondary}" />

                <!-- Read-only: what a window with no way to apply an edit should show. -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Value}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CanEditParameters,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Editable. Three shapes, because a toggle rendered as a text box asking for the
                     word "true" is a worse control than no control. -->
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CanEditParameters,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Value, Converter={x:Static render:TextToBooleanConverter.Instance},
                                          UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding IsBoolean, Converter={StaticResource B2V}}" />

                    <ComboBox ItemsSource="{Binding Choices}" Padding="5,2" FontSize="11"
                              SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding IsChoice, Converter={StaticResource B2V}}" />

                    <!-- The instrument picker. Editable so it filters as the user types, which is how
                         the shared InstrumentPicker behaves in Charts / OrderBook / Footprint; the
                         list is short enough here that the view-model side of that filter is not
                         worth carrying. SelectedValuePath is the id text the editor already stores,
                         so choosing a row is the same as typing its id and TryParse stays the single
                         place a value is validated. -->
                    <ComboBox ItemsSource="{Binding Instruments}" Padding="5,2" FontSize="11"
                              IsEditable="False"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="IdText"
                              SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding IsInstrument, Converter={StaticResource B2V}}" />

                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5,2" FontSize="11"
                             FontFamily="{DynamicResource Font.Data}"
                             Visibility="{Binding IsFreeText, Converter={StaticResource B2V}}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <!-- The range the author declared, enforced where it can still be
                                         corrected. A bad value reaching the sandbox comes back as a
                                         failed start, which reads as the unit being broken. -->
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Bearish.Brush}" />
                                        <Setter Property="BorderThickness" Value="1.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Unit}" FontSize="10"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}" />

                <!-- The range, or what is wrong with what was typed. One line, never both. -->
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="9.5"
                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding RangeHint}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                            <Setter Property="Opacity" Value="0.75" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Text" Value="{Binding Error}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Bearish.Brush}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- run state -->
            <RowDefinition Height="Auto" />  <!-- parameters -->
            <RowDefinition Height="*" />     <!-- the author's picture -->
            <RowDefinition Height="Auto" />  <!-- virtual book, strategies only -->
            <RowDefinition Height="Auto" />  <!-- activity log -->
        </Grid.RowDefinitions>

        <!--
            Run state.

            A window that draws is not necessarily a window that is receiving data: a frozen picture
            and a quiet market look identical, and the only way to tell them apart used to be reading
            the activity log. One dot and one word.
        -->
        <Border Grid.Row="0"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="12,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="10,2" FontSize="10.5" MinWidth="66"
                        Command="{Binding TogglePauseCommand}"
                        Visibility="{Binding CanPause, Converter={StaticResource B2V}}">
                    <Button.Style>
                        <!-- BasedOn is load-bearing. A <Style TargetType="Button"> declared inline
                             REPLACES the application's default Button style rather than extending it,
                             so this rendered as stock WPF chrome — a pale grey slab with unreadable
                             text — on a dark surface where every other button was themed. It was
                             invisible in every test, because a control that is styled wrongly still
                             measures, arranges and answers its bindings. -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Pause" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="False">
                                    <Setter Property="Content" Value="Resume" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Text.Secondary}" />
                            <Setter Property="Opacity" Value="0.4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Bullish.Brush}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock DockPanel.Dock="Left" Text="{Binding RunState}" FontSize="10.5"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Primary}" />

                <TextBlock Text="{Binding ParameterStatus}" FontSize="10.5" Margin="14,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Secondary}" />
            </DockPanel>
        </Border>

        <!--
            Parameters. Hidden when the unit declares none, which is what makes a visualizer's window
            the log-only shape asked for: a strategy always has parameters so it always shows, and a
            visualizer usually has none so it usually does not. Keyed off what the unit actually
            declares rather than off its kind, so a visualizer that DOES take parameters still shows
            them instead of having them silently swallowed.
        -->
        <Expander Grid.Row="1"
                  Visibility="{Binding HasSetup, Converter={StaticResource B2V}, FallbackValue=Collapsed}"
                  IsExpanded="{Binding IsSetupExpanded, Mode=TwoWay}"
                  Background="{DynamicResource Background.Elevated}"
                  BorderBrush="{DynamicResource Border.Brush}"
                  BorderThickness="0,0,0,1"
                  Padding="12,8">
            <!--
                MahApps paints an expander header with MahApps.Brushes.Accent, which under the shipped
                Dark.Blue theme is #FF2962FF — a saturated blue band across the full width of the
                window, reading as a selection highlight and leaving the "PARAMETERS" caption nearly
                unreadable on top of it.

                Overridden HERE rather than app-wide: the accent is correct everywhere else it is used,
                and a scoped resource is a local decision about one header rather than a change to
                every MahApps control in the shell. DynamicResource in the template is what makes the
                scoped override reach it.
            -->
            <Expander.Resources>
                <!--
                    Brushes over the theme's own COLOURS, resolved dynamically.

                    `<StaticResource ResourceKey="Background.Elevated"/>` reads better and is wrong:
                    StaticResource THROWS at parse time when the key is absent, and this control is
                    base-layer — it loads in hosts that have not merged the theme, including its own
                    test project, where every one of those loads died with "Cannot find resource named
                    'Background.Elevated'". DynamicResource is what the rest of this file uses, for
                    exactly that reason: a missing key costs the colour, not the window.
                -->
                <SolidColorBrush x:Key="MahApps.Brushes.Accent"
                                 Color="{DynamicResource Background.Elevated.Color}" />
                <SolidColorBrush x:Key="MahApps.Brushes.Accent2"
                                 Color="{DynamicResource Background.Elevated.Color}" />
                <SolidColorBrush x:Key="MahApps.Brushes.Highlight"
                                 Color="{DynamicResource Border.Strong.Color}" />
            </Expander.Resources>
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  PARAMETERS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                    <!-- An unapplied edit is easy to leave behind once the expander is collapsed, and
                         then the picture disagrees with the numbers on screen. -->
                    <TextBlock Text="  ·  UNAPPLIED" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Warning.Brush}" VerticalAlignment="Center"
                               Visibility="{Binding HasPendingChanges, Converter={StaticResource B2V}}" />
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,8,0,4">
                <ItemsControl ItemsSource="{Binding Parameters}"
                              ItemTemplate="{StaticResource ParameterRow}" />

                <DockPanel Margin="0,10,0,0"
                           Visibility="{Binding CanEditParameters, Converter={StaticResource B2V}}">
                    <Button DockPanel.Dock="Left" Content="Apply" Padding="14,4" FontSize="11"
                            Command="{Binding ApplyParametersCommand}"
                            IsEnabled="{Binding HasPendingChanges}" />
                    <Button DockPanel.Dock="Left" Content="Reset" Padding="12,4" FontSize="11"
                            Margin="7,0,0,0"
                            Command="{Binding ResetParametersCommand}"
                            IsEnabled="{Binding HasPendingChanges}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="10"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                               Text="Applying restarts the unit with these values. Its history starts again; the log does not." />
                </DockPanel>

                <!--
                    The unit's own verbs. Separated from Apply/Reset by a rule because they are a
                    different kind of thing: those two commit a value, these happen when pressed and
                    have nothing to commit. Sitting them in the same row would make an action look
                    like an edit waiting to be applied.
                -->
                <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Border.Brush}"
                        Visibility="{Binding HasActions, Converter={StaticResource B2V}}">
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Padding="12,4" FontSize="11"
                                        Margin="0,0,7,6"
                                        ToolTip="{Binding Detail}"
                                        Command="{Binding DataContext.InvokeActionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Expander>

        <!--
            The author's picture. One panel by default; a unit that declares a UnitLayout gets that
            tree built into real panels with headers and draggable separators.
        -->
        <render:AuthoredUnitLayoutHost x:Name="Body" Grid.Row="2"
                                       Layout="{Binding Layout}"
                                       Draw="{Binding Draw}" />

        <!-- ── Virtual book (strategies only) ─────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="{Binding HasBook, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BOOK" FontWeight="Bold" FontSize="9.5"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock FontSize="11" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center">
                    <Run Text="Position" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.PositionUnits, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   @ " Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.AverageEntryPrice, Mode=OneWay, StringFormat=N4}" />
                    <Run Text="   Realised" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.RealizedProfitAndLoss, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   Equity" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.Equity, Mode=OneWay, StringFormat=N2}" />
                    <Run Text="   Resting" Foreground="{DynamicResource Text.Secondary}" />
                    <Run Text="{Binding Book.OpenOrders, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Activity log ───────────────────────────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                MaxHeight="140">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="10,6">
                <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource Text.Secondary}">
                                <Run Text="{Binding TimestampUtc, Mode=OneWay, StringFormat=HH\:mm\:ss}" />
                                <Run Text="{Binding Source, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent.Brush}" />
                                <Run Text="{Binding Message, Mode=OneWay}"
                                     Foreground="{DynamicResource Text.Primary}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
