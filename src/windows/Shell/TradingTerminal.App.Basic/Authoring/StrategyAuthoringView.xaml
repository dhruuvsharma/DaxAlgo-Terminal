<UserControl x:Class="TradingTerminal.App.Authoring.StrategyAuthoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:uicontrols="clr-namespace:TradingTerminal.UI.Controls;assembly=TradingTerminal.UI"
             xmlns:render="clr-namespace:TradingTerminal.UI.Controls.Render;assembly=TradingTerminal.UI"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1480"
             Background="{DynamicResource Background.Primary}"
             Foreground="{DynamicResource Text.Primary}">

    <!-- ═══════════════════════════════════════════════════════════════════════════════════
         HYPERION — vibe-code a trading idea (issue #29).

         FOUR REGIONS, laid out the way an editor lays them out:

             ┌────────┬──────────────────────────┬───────────────┐
             │ rail   │ header                   │ workbench     │
             │ search │ ────────────────────────  │ Preview       │
             │ Today  │ transcript                │ Code          │
             │  …     │ (one column, one margin)  │ Activity      │
             │ Older  │ ────────────────────────  │               │
             │ prov.  │ composer                  │               │
             ├────────┴──────────────────────────┴───────────────┤
             │ status bar: state · kind · model · tokens · clock │
             └───────────────────────────────────────────────────┘

         THE STATUS BAR IS THE POINT OF THE REBUILD. Everything ambient used to be a chip
         somewhere: the elapsed clock in the session header, the token spend in a corner of a
         panel that is CLOSED BY DEFAULT, the model on a pill inside the composer, the state
         implied by whether a shimmer was moving. So the one number the user is billed for
         lived where they had to go and find it. It is a permanent rule across the bottom now,
         which is where every editor puts exactly this class of fact, and the panels above are
         free to be about their own content.

         Everything visual is HYP.* from the app-merged HyperionStyles.xaml; this file is
         layout and typed wiring only.
         ═══════════════════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The rail's rows, grouped by recency. Live-grouped, so a session that gets a turn
                 moves from "Yesterday" to "Today" without a rebuild. Source binds through the
                 owning element's inheritance context — the same pattern the provider window uses. -->
            <CollectionViewSource x:Key="SessionGroups" Source="{Binding VisibleSessions}"
                                  IsLiveGroupingRequested="True">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
                <CollectionViewSource.LiveGroupingProperties>
                    <sys:String>Group</sys:String>
                </CollectionViewSource.LiveGroupingProperties>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Both panels are chrome around a text box, and reaching for the mouse to get a bigger text box
         is the friction the people this is for left other tools to avoid. Ctrl+B / Ctrl+J are the
         bindings their editor already uses for exactly these two panels. -->
    <UserControl.InputBindings>
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleRailCommand}" />
        <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding ToggleWorkbenchCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />   <!-- status bar, spanning everything -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Session rail ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0">
                <Border.Resources>
                    <Style x:Key="RailPanel" TargetType="FrameworkElement">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource HYP.RailBorder}">
                        <Setter Property="Width" Value="{StaticResource HYP.Rail.Width}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
                                <Setter Property="Width" Value="48" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel Margin="9,10,9,8">
                    <!-- Brand lockup + collapse. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource HYP.HeroMark}" Width="24" Height="24">
                                <TextBlock Text="H" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource RailPanel}">
                                <TextBlock Text="Hyperion" FontWeight="Bold" FontSize="12.5"
                                           Foreground="{DynamicResource Text.Header}" />
                                <TextBlock Text="vibe-code your trading ideas" FontSize="9"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource HYP.IconButton}" FontSize="11"
                                Command="{Binding ToggleRailCommand}"
                                ToolTip="Collapse / expand the session rail  (Ctrl+B)">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⟨" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
                                                <Setter Property="Text" Value="⟩" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Button DockPanel.Dock="Top" Style="{StaticResource HYP.NewButton}" Margin="0,0,0,7"
                            Command="{Binding NewChatCommand}"
                            ToolTip="Start a fresh session — the current one stays in the rail.">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="＋   New session" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
                                            <Setter Property="Text" Value="＋" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>


                    <!-- Search. Sessions accumulate — that is what saving them is FOR — and a
                         history you can only scroll stops being used at about thirty entries. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4" Style="{StaticResource RailPanel}">
                        <TextBox Style="{StaticResource HYP.Field}" FontSize="11" Padding="24,4,22,4"
                                 Text="{Binding SessionQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by name, id, or the brief the session opened with" />
                        <TextBlock Text="⌕" FontSize="12" Margin="7,0,0,0" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Text="Search sessions" FontSize="11" Margin="25,0,0,0"
                                   IsHitTestVisible="False" Opacity="0.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right" Style="{StaticResource HYP.IconButton}"
                                Content="✕" FontSize="9" Margin="0,0,2,0"
                                Command="{Binding ClearSessionQueryCommand}"
                                Visibility="{Binding SessionQuery, Converter={StaticResource HYP.S2V}}"
                                ToolTip="Clear the search" />
                    </Grid>

                    <!-- Provider health, pinned to the bottom: the rail's answer to "why is
                         nothing happening when I press Send". -->
                    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource RailPanel}"
                                Margin="0,8,0,0">
                        <Border BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,0"
                                Padding="0,7,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <!-- The footer used to report that no provider was configured and
                                         give no way to configure one, which left the user to go and
                                         find a settings page from a dead end. -->
                                    <Button DockPanel.Dock="Right" Content="Manage…"
                                            Style="{StaticResource HYP.LinkButton}"
                                            Command="{Binding OpenProviderSettingsCommand}"
                                            ToolTip="Add an API key or connect an agent CLI" />
                                    <TextBlock Text="PROVIDERS" Style="{StaticResource HYP.SectionLabel}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding AiProviders}"
                                              ItemTemplate="{StaticResource HYP.ProviderRow}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- The history itself. -->
                    <Grid Style="{StaticResource RailPanel}">
                        <ListBox ItemsSource="{Binding Source={StaticResource SessionGroups}}"
                                 SelectedItem="{Binding SelectedSavedSession}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource HYP.SessionItem}"
                                 ItemTemplate="{StaticResource HYP.SessionTemplate}">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource HYP.SessionGroupHeader}" />
                            </ListBox.GroupStyle>
                        </ListBox>

                        <!-- Two different emptinesses, and they need different words: nothing saved
                             yet, versus a search that matched nothing. -->
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="9,14,9,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Text.Secondary}" Opacity="0.8"
                                   Text="Your sessions appear here. They are saved as you go and survive a restart."
                                   Visibility="{Binding HasSavedSessions, Converter={StaticResource HYP.NotB2V}}" />
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="9,14,9,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Text.Secondary}" Opacity="0.8"
                                   Text="No session matches that search."
                                   Visibility="{Binding HasNoSessionMatches, Converter={StaticResource HYP.B2V}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ═══ Conversation ═══════════════════════════════════════════════════════════
                 Three rows: header · transcript · composer. Everything belonging to the
                 conversation flows INSIDE the transcript in document order — the working
                 status, the model's questions, the one-click replies — ending where the
                 composer begins, so the turn you are reading and the control that answers it
                 are adjacent. One column at a fixed measure, because a reading measure is a
                 reading measure whatever the window is doing.
                 ═══════════════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Session header: only once there is a session to name. -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="26,10"
                        BorderBrush="{DynamicResource Border.Brush}"
                        Visibility="{Binding HasConversation, Converter={StaticResource HYP.B2V}}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Margin="10,0,0,0"
                                      Style="{StaticResource HYP.PillButton}"
                                      IsChecked="{Binding IsWorkbenchOpen, Mode=TwoWay}"
                                      Content="Workbench  ⌃J"
                                      ToolTip="The picture, the source and the log. Closed by default — the conversation is the workspace." />

                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="{DynamicResource Text.Header}" /><Run Text="   " /><Run
                                 Text="{Binding StrategyId, Mode=OneWay}" FontSize="10.5"
                                 FontFamily="{DynamicResource Font.Data}"
                                 Foreground="{DynamicResource Text.Secondary}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,0,10"
                                  Visibility="{Binding HasConversation, Converter={StaticResource HYP.B2V}}">
                        <!-- Stretch, not Center. The transcript, the hero and the composer are three
                             separate elements that must sit on ONE margin, and they only do that if
                             all three are given identical alignment, measure and margin — whatever
                             WPF then does with the leftover space, it does to all three. Centring one
                             and stretching another is how a column ends up half a margin out of true
                             at some window widths and correct at others. -->
                        <StackPanel MaxWidth="{StaticResource HYP.Measure}" HorizontalAlignment="Stretch"
                                    Margin="26,0,26,0">

                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource HYP.MessageSwitch}"
                                                        Content="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- What it is doing right now, at the bottom of the thread where the
                                 next message will appear — not pinned to a strip above the composer. -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource HYP.B2V}}">
                                <ContentControl Style="{StaticResource HYP.ShimmerLabel}"
                                                Content="{Binding WorkingVerb}" />
                                <TextBlock Style="{StaticResource HYP.GhostText}" Margin="10,0,0,0"
                                           Text="{Binding StepText}" />
                            </StackPanel>

                            <!-- The model's questions, as part of the turn that asked them. -->
                            <ItemsControl Margin="0,14,0,0"
                                          ItemsSource="{Binding Questions}"
                                          Visibility="{Binding HasQuestions, Converter={StaticResource HYP.B2V}, FallbackValue=Collapsed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HYP.QuestionCard}" Margin="0,0,0,8">
                                            <Grid>
                                                <Border Width="2" HorizontalAlignment="Left"
                                                        Margin="-13,-11,0,-11"
                                                        Background="{DynamicResource Ai.Accent.Brush}" />
                                                <StackPanel Margin="4,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Primary}" />
                                                        <TextBlock Text="{Binding ModeHint}" Margin="8,1,0,0"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Secondary}" />
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ToggleButton Style="{StaticResource HYP.OptionChip}"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                                   Foreground="{DynamicResource Text.Primary}" />
                                                                        <TextBlock Text="{Binding Detail}" FontSize="9.5"
                                                                                   Margin="0,1,0,0" TextWrapping="Wrap"
                                                                                   MaxWidth="220"
                                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                                   Visibility="{Binding HasDetail, Converter={StaticResource HYP.B2V}}" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBox Style="{StaticResource HYP.Field}" FontSize="11"
                                                             Text="{Binding Other, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,2,0,0"
                                                             ToolTip="Something else — typed answers are added to whatever you picked"
                                                             Visibility="{Binding AllowOther, Converter={StaticResource HYP.B2V}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Style="{StaticResource HYP.SendButton}"
                                    Command="{Binding SubmitAnswersCommand}"
                                    Content="Submit answers"
                                    Visibility="{Binding HasQuestions, Converter={StaticResource HYP.B2V}, FallbackValue=Collapsed}" />

                            <!-- The one-click replies. Last thing in the thread, directly above the
                                 composer, which is where an answer goes. -->
                            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,12,0,2"
                                          Visibility="{Binding HasActions, Converter={StaticResource HYP.B2V}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,6"
                                                Content="{Binding Label}"
                                                Command="{Binding DataContext.ChooseCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HYP.SuggestionChip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border CornerRadius="{StaticResource HYP.Radius.S}"
                                                                                Padding="11,6" Cursor="Hand"
                                                                                Background="{DynamicResource Ai.Accent.Brush}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding AiStatus}"
                                       Visibility="{Binding AiStatus, Converter={StaticResource HYP.S2V}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Hero: first run, and every new session. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                MaxWidth="{StaticResource HYP.Measure}" Margin="26,0"
                                Visibility="{Binding HasConversation, Converter={StaticResource HYP.NotB2V}}">
                        <Border Style="{StaticResource HYP.HeroMark}" Width="42" Height="42"
                                HorizontalAlignment="Left">
                            <TextBlock Text="H" Foreground="White" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Describe the trade. Watch it get built."
                                   FontSize="21" FontWeight="SemiBold" Margin="0,16,0,6"
                                   Foreground="{DynamicResource Text.Header}" />
                        <!-- Capped tighter than the column: 820px of running prose is past the measure
                             a line of body text stays readable at. The COLUMN is 820 so the three
                             regions share one margin; this paragraph just wraps sooner inside it. -->
                        <TextBlock TextWrapping="Wrap" FontSize="12" MaxWidth="580"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="Hyperion plans it, writes the C#, compiles it and smoke-tests it against synthetic market data. You read the code and decide whether it gets registered." />

                        <!-- Starter briefs, when a provider can actually be called… -->
                        <ItemsControl ItemsSource="{Binding SuggestionBriefs}" Margin="0,20,0,0"
                                      Visibility="{Binding AiHasProvider, Converter={StaticResource HYP.B2V}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HYP.SuggestionChip}" Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Put this brief in the composer — edit it, then send.">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- …and the setup route when none can. -->
                        <Border Style="{StaticResource HYP.QuestionCard}" Margin="0,18,0,0"
                                Visibility="{Binding AiHasProvider, Converter={StaticResource HYP.NotB2V}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource Text.Primary}">
                                    <Run Text="No AI provider is set up yet." FontWeight="SemiBold" /><Run Text=" " /><Run
                                         Text="Add an API key or sign in to an agent CLI, then come back — or write the strategy yourself in the workbench and press Compile &amp; Register." />
                                </TextBlock>
                                <Button HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Style="{StaticResource HYP.CtaButton}"
                                        Content="Set up a provider"
                                        Command="{Binding OpenProviderSettingsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══ Composer ═══ -->
                <ContentControl Grid.Row="2" Style="{StaticResource HYP.ComposerShell}"
                                MaxWidth="{StaticResource HYP.Measure}" HorizontalAlignment="Stretch"
                                Margin="26,0,26,16" Padding="12,10" Tag="{Binding IsGenerating}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />     <!-- prompt -->
                            <RowDefinition Height="Auto" />  <!-- kind notice, when there is one -->
                            <RowDefinition Height="Auto" />  <!-- control strip -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBox MinHeight="52" MaxHeight="220" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" Padding="2"
                                     FontSize="13"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Ai.Accent.Brush}"
                                     Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="4,4,0,0" FontSize="13" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Text.Secondary}" Opacity="0.5"
                                       Text="Describe the strategy — or refine what is there. Ctrl+Enter sends.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Composer}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding AuthoringKindNotice}"
                                   Visibility="{Binding AuthoringKindNotice, Converter={StaticResource HYP.S2V}}"
                                   FontSize="10.5" TextWrapping="Wrap" Margin="2,7,0,0"
                                   Foreground="{DynamicResource Text.Secondary}" />

                        <!-- kind · model · effort ……… send -->
                        <DockPanel Grid.Row="2" Margin="0,9,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HYP.SendButton}"
                                    Command="{Binding SendCommand}" Content="Send  ⌃⏎"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource HYP.NotB2V}}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource HYP.StopButton}"
                                    Command="{Binding StopCommand}" Content="■  Stop"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource HYP.B2V}}" />

                            <StackPanel Orientation="Horizontal">
                                <!-- First in the row because it is the biggest decision in it:
                                     model and effort are settings, this decides what comes out. -->
                                <ToggleButton Style="{DynamicResource HYP.KindSegment}"
                                              Margin="0,0,10,0"
                                              IsChecked="{Binding IsAuthoringVisualizer, Mode=TwoWay}" />
                                <ToggleButton x:Name="ModelPill" Style="{StaticResource HYP.PillButton.Ai}"
                                              ToolTip="Every model the app can reach, tagged by provider — plus a custom-id box.">
                                    <TextBlock>
                                        <Run Text="◇ " /><Run Text="{Binding ModelPillText, Mode=OneWay}" /><Run Text="  ▾" />
                                    </TextBlock>
                                </ToggleButton>
                                <ToggleButton x:Name="BuildPill" Style="{StaticResource HYP.PillButton}" Margin="6,0,0,0"
                                              ToolTip="The single effort dial: how many skills are loaded, how many auto-fix attempts are allowed, whether the agents and the verification ladder run — and how hard the model is asked to think. Quick sketches; Max builds and checks.">
                                    <TextBlock>
                                        <Run Text="Build: " /><Run Text="{Binding BuildEffort, Mode=OneWay}" /><Run Text="  ▾" />
                                    </TextBlock>
                                </ToggleButton>
                            </StackPanel>
                        </DockPanel>

                        <!-- Flyouts -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=ModelPill, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ModelPill}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border Style="{StaticResource HYP.FlyoutCard}" MinWidth="360" MaxWidth="460">
                                <StackPanel>
                                    <TextBlock Text="MODEL" Style="{StaticResource HYP.SectionLabel}"
                                               Margin="4,0,0,5" />
                                    <ListBox x:Name="ModelList" ItemsSource="{Binding AllModels}"
                                             SelectedItem="{Binding SelectedModelChoice}"
                                             MaxHeight="280" BorderThickness="0" Background="Transparent"
                                             SelectionChanged="OnFlyoutSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Row" FontSize="11.5"
                                                           FontFamily="{DynamicResource Font.Data}"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Display, Mode=OneWay}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,0"
                                            Margin="0,6,0,0" Padding="0,7,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Custom id" VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource Text.Secondary}" Margin="2,0,7,0" />
                                            <Button DockPanel.Dock="Right" Content="↻" Margin="6,0,0,0"
                                                    Style="{StaticResource HYP.IconButton}"
                                                    ToolTip="Ask the provider what models this key can actually call"
                                                    Command="{Binding RefreshModelsCommand}" />
                                            <TextBox Style="{StaticResource HYP.Field}" FontSize="11"
                                                     FontFamily="{DynamicResource Font.Data}"
                                                     Text="{Binding SelectedModel, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Type any model id the selected provider accepts (overrides the picker)." />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup IsOpen="{Binding IsChecked, ElementName=BuildPill, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=BuildPill}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border Style="{StaticResource HYP.FlyoutCard}" MinWidth="160">
                                <StackPanel>
                                    <TextBlock Text="BUILD EFFORT" Style="{StaticResource HYP.SectionLabel}"
                                               Margin="4,0,0,5" />
                                    <ListBox x:Name="BuildList" ItemsSource="{Binding BuildEfforts}"
                                             SelectedItem="{Binding BuildEffort}"
                                             BorderThickness="0" Background="Transparent"
                                             SelectionChanged="OnFlyoutSelectionChanged" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ContentControl>
            </Grid>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsWorkbenchOpen, Converter={StaticResource HYP.B2V}}" />

            <!-- ═══ Workbench ══════════════════════════════════════════════════════════════
                 The artifact panel. It OPENS ITSELF the moment there is something in it — a
                 compiled unit, or a file the user clicked in the chat — rather than occupying
                 a third of the window for a whole session showing an empty preview beside a
                 hero screen inviting you to type. The header pill closes it again.
                 ═══════════════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="3" Width="{StaticResource HYP.Workbench.Width}"
                    Style="{StaticResource HYP.WorkbenchBorder}"
                    Visibility="{Binding IsWorkbenchOpen, Converter={StaticResource HYP.B2V}}">
                <DockPanel>
                    <!-- Identity and the review gate's entry point. -->
                    <Border DockPanel.Dock="Top" Padding="12,12,12,11"
                            BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ID" Style="{StaticResource HYP.SectionLabel}"
                                               Margin="1,0,0,3" />
                                    <TextBox Style="{StaticResource HYP.Field}"
                                             FontFamily="{DynamicResource Font.Data}"
                                             Text="{Binding StrategyId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NAME" Style="{StaticResource HYP.SectionLabel}"
                                               Margin="1,0,0,3" />
                                    <TextBox Style="{StaticResource HYP.Field}"
                                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource HYP.StateChip}"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock FontSize="9" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="DRAFT" />
                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                                        <Setter Property="Text" Value="REGISTERED" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Bullish.Brush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource HYP.CtaButton}" Content="⚡  Compile &amp; Register"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding CompileCommand}"
                                        ToolTip="Compile every file, then review the code before it is registered — it runs in-process." />
                            </DockPanel>

                            <TextBlock Margin="1,8,0,0" TextWrapping="Wrap" FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding Status}"
                                       Visibility="{Binding Status, Converter={StaticResource HYP.S2V}}" />

                            <!-- Registering also writes a .daxalgostrategy the user can back up, send
                                 to someone, or install elsewhere. A file nobody is told about is a
                                 file that does not exist to them. -->
                            <Button HorizontalAlignment="Left" Margin="1,6,0,0"
                                    Content="Show the packaged file"
                                    Style="{StaticResource HYP.LinkButton}"
                                    Command="{Binding ShowArtifactCommand}"
                                    ToolTip="{Binding ArtifactPath}"
                                    Visibility="{Binding ArtifactPath, Converter={StaticResource HYP.S2V}}" />
                        </StackPanel>
                    </Border>

                    <!-- Agent-CLI hand-off: only when a CLI actually resolved on PATH. -->
                    <Border DockPanel.Dock="Bottom" Padding="12,6"
                            BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableClis.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open workspace in" Style="{StaticResource HYP.GhostText}"
                                       Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding AvailableClis}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,0" FontSize="10.5"
                                                Style="{StaticResource HYP.SuggestionChip}"
                                                Command="{Binding DataContext.LaunchCliCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding DisplayName}"
                                                ToolTip="Scaffold this strategy's workspace and open the agent CLI there" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Preview · Code · Activity.
                         Parameters is deliberately absent: every unit's own window carries a
                         parameters expander, so a copy here would be a worse version of a surface
                         the user is about to get anyway. Activity is NOT the same argument — it is
                         the authoring log (what the compiler and the agents did), it exists
                         nowhere else, and it is the first thing anybody asks for when a build
                         goes wrong. -->
                    <TabControl Style="{StaticResource HYP.TabStrip}" Margin="12,4,12,8"
                                SelectedIndex="{Binding WorkbenchTab}">

                        <!-- Preview leads, because a picture is how a unit is actually reviewed.
                             Reading generated C# tells you almost nothing about whether the axes
                             are sensible or whether it drew at all. The surface is the one the
                             live window uses and the frame is the one the verifier judged. -->
                        <TabItem Header="Preview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource HYP.EditorFrame}">
                                    <Grid>
                                        <render:AuthoredUnitLayoutHost Layout="{Binding PreviewLayout}"
                                                                       Draw="{Binding PreviewDraw}" Margin="6">
                                            <render:AuthoredUnitLayoutHost.Style>
                                                <Style TargetType="render:AuthoredUnitLayoutHost">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </render:AuthoredUnitLayoutHost.Style>
                                        </render:AuthoredUnitLayoutHost>

                                        <!-- Never an unexplained empty rectangle: a blank panel reads
                                             as a broken application rather than as a unit that has
                                             not been built yet. -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Nothing drawn yet." FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                            <TextBlock Text="Compile a preview to see one frame."
                                                       FontSize="10.5" Margin="0,3,0,0"
                                                       HorizontalAlignment="Center" Opacity="0.75"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Compiles and draws, and registers nothing. Looking at the picture
                                     is not a decision, so it must not cost the consent dialogue that
                                     registration rightly asks for — that is how people stop looking. -->
                                <DockPanel Grid.Row="1" Margin="1,8,1,0">
                                    <Button DockPanel.Dock="Right" Content="↻  Compile preview"
                                            VerticalAlignment="Top" FontSize="10.5"
                                            Style="{StaticResource HYP.SuggestionChip}"
                                            Command="{Binding CompilePreviewCommand}"
                                            ToolTip="Build it and draw one frame. Nothing is registered." />
                                    <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"
                                               FontSize="10.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Secondary}" />
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Code">
                            <DockPanel>
                                <!-- File tabs, plus add/remove. -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="＋" Style="{StaticResource HYP.IconButton}"
                                                Command="{Binding AddFileCommand}" ToolTip="Add a helper file" />
                                        <Button Content="−" Style="{StaticResource HYP.IconButton}"
                                                Command="{Binding RemoveFileCommand}"
                                                CommandParameter="{Binding SelectedFile}"
                                                ToolTip="Remove this file" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                             Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource HYP.FileTab}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                           FontFamily="{DynamicResource Font.Data}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- Problems drawer, at the bottom where a problems panel goes. -->
                                <Border DockPanel.Dock="Bottom" Margin="0,7,0,0"
                                        BorderBrush="{DynamicResource Border.Brush}" BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Diagnostics.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <ToggleButton x:Name="DiagToggle" DockPanel.Dock="Top" IsChecked="True"
                                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                      HorizontalContentAlignment="Left" Padding="0,6,0,4">
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Warning.Brush}">
                                                <Run Text="PROBLEMS · " FontWeight="Bold" /><Run
                                                     Text="{Binding Diagnostics.Count, Mode=OneWay}" /><Run
                                                     Text="   click a row to open its file"
                                                     Foreground="{DynamicResource Text.Secondary}" />
                                            </TextBlock>
                                        </ToggleButton>
                                        <ListBox ItemsSource="{Binding Diagnostics}" MaxHeight="150"
                                                 SelectedItem="{Binding SelectedDiagnostic}"
                                                 Background="Transparent" BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ItemTemplate="{StaticResource HYP.DiagnosticRow}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Visibility="{Binding IsChecked, ElementName=DiagToggle, Converter={StaticResource HYP.B2V}}" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource HYP.EditorFrame}">
                                    <uicontrols:CodeEditor Margin="2"
                                                           Code="{Binding SelectedFile.Content}"
                                                           FontFamily="{DynamicResource Font.Data}" FontSize="12"
                                                           Background="Transparent"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           LineNumbersForeground="{DynamicResource Text.Secondary}"
                                                           HorizontalScrollBarVisibility="Auto"
                                                           VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Activity">
                            <Border Style="{StaticResource HYP.EditorFrame}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,7">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding Activity}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                                               FontFamily="{DynamicResource Font.Data}" FontSize="10.5"
                                                               Foreground="{DynamicResource Text.Secondary}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="The compiler's and the agents' steps appear here while a turn runs."
                                                   TextWrapping="Wrap" FontSize="10.5" Opacity="0.75"
                                                   Foreground="{DynamicResource Text.Secondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activity.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Status bar ═════════════════════════════════════════════════════════════════
             Spans all three columns. Left: what the workspace is doing. Right: what it is
             doing it with, and what that has cost.
             ═══════════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource HYP.StatusBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- The token meter. Three proportional segments of one bar: fresh input,
                         cached input, output. There is no context-window gauge because nothing
                         here knows any model's window — see the view-model. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                Visibility="{Binding HasUsage, Converter={StaticResource HYP.B2V}}"
                                ToolTip="{Binding UsageDetail}">
                        <Border Style="{StaticResource HYP.MeterTrack}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{Binding MeterInputWidth}"
                                        Background="{DynamicResource Ai.Accent.Brush}" />
                                <Border Width="{Binding MeterCachedWidth}" Opacity="0.35"
                                        Background="{DynamicResource Ai.Accent.Brush}" />
                                <Border Width="{Binding MeterOutputWidth}"
                                        Background="{DynamicResource Accent.Brush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource HYP.StatusText}" Margin="7,0,0,0">
                            <Run Text="{Binding TotalTokensText, Mode=OneWay}" /><Run Text=" tok" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Said plainly when the provider reports nothing: unknown is not free. The rule
                         lives on the view-model (UsageFallbackText), so this is one binding rather
                         than a second copy of the decision written as a trigger. -->
                    <TextBlock Style="{StaticResource HYP.StatusText}" Margin="0,0,14,0"
                               Text="{Binding UsageFallbackText, Mode=OneWay}"
                               Visibility="{Binding UsageFallbackText, Converter={StaticResource HYP.S2V}}"
                               ToolTip="This provider — usually an agent CLI — does not report usage. You are still billed by it." />

                    <TextBlock Style="{StaticResource HYP.StatusText}" Margin="0,0,14,0"
                               Text="{Binding BuildEffort, Mode=OneWay, StringFormat=build: {0}}" />

                    <TextBlock Style="{StaticResource HYP.StatusText}"
                               Foreground="{DynamicResource Ai.Text.Brush}"
                               Text="{Binding ModelPillText, Mode=OneWay}"
                               ToolTip="The model this session sends to. Change it in the composer." />

                    <TextBlock Style="{StaticResource HYP.StatusText}" Margin="14,0,0,0"
                               Text="{Binding ElapsedCompact, Mode=OneWay}"
                               Visibility="{Binding IsGenerating, Converter={StaticResource HYP.B2V}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource HYP.StateDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKind}" Value="Busy">
                                        <Setter Property="Fill" Value="{DynamicResource Ai.Accent.Brush}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKind}" Value="Ask">
                                        <Setter Property="Fill" Value="{DynamicResource Warning.Brush}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKind}" Value="Error">
                                        <Setter Property="Fill" Value="{DynamicResource Danger.Brush}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Style="{StaticResource HYP.StatusText}"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{Binding StateText, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource HYP.StatusText}" Margin="10,0,0,0"
                               Text="{Binding WorkingVerb, Mode=OneWay}"
                               Visibility="{Binding IsGenerating, Converter={StaticResource HYP.B2V}}" />

                    <TextBlock Style="{StaticResource HYP.StatusText}" Margin="10,0,0,0" Opacity="0.7"
                               Text="{Binding StepText, Mode=OneWay}"
                               Visibility="{Binding IsGenerating, Converter={StaticResource HYP.B2V}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Review gate — the ONLY path to registration ════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding ReviewOpen, Converter={StaticResource HYP.B2V}}">
            <Border Style="{StaticResource HYP.OverlayDim}" />
            <Border Style="{StaticResource HYP.OverlayCard}" MaxWidth="940" MaxHeight="660"
                    Margin="40" Padding="18,16" VerticalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Review before registering" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Header}" />
                        <TextBlock Text="{Binding ReviewSummary}" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Back" Margin="0,0,8,0"
                                    Style="{StaticResource HYP.SuggestionChip}"
                                    Command="{Binding CancelReviewCommand}" />
                            <Button Style="{StaticResource HYP.CtaButton}" Content="Register strategy"
                                    Command="{Binding ConfirmRegisterCommand}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="Registering runs this code in-process. The policy scan already rejected P/Invoke, processes and the registry." />
                    </DockPanel>

                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding ReviewFiles}"
                             SelectedItem="{Binding SelectedReviewFile}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource HYP.FileTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="10.5" FontFamily="{DynamicResource Font.Data}">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run
                                         Text="{Binding Counts, Mode=OneWay}"
                                         Foreground="{DynamicResource Bullish.Brush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource HYP.EditorFrame}" Margin="0,6,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" Padding="0,4">
                            <ItemsControl ItemsSource="{Binding SelectedReviewFile.Lines}"
                                          ItemTemplate="{StaticResource HYP.DiffLine}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
