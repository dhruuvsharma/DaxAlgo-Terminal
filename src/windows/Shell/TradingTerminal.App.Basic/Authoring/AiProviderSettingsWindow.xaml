<mah:MetroWindow x:Class="TradingTerminal.App.Authoring.AiProviderSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="AI providers"
                 Width="880" Height="640" MinWidth="660" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ShowMaxRestoreButton="False"
                 Background="{DynamicResource Background.Primary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!-- One provider in the list. Availability is the only thing that has to read at a glance,
             so it is a dot rather than a word competing with the name. -->
        <DataTemplate x:Key="ProviderListRow">
            <DockPanel Margin="0,3">
                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Text.Secondary}" />
                            <Setter Property="Opacity" Value="0.35" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Bullish.Brush}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock DockPanel.Dock="Right" Text="DEFAULT" FontSize="8" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource Ai.Text.Brush}"
                           Visibility="{Binding IsDefault, Converter={StaticResource B2V}}" />

                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Text.Primary}" FontSize="12" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── The list ──────────────────────────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="PROVIDERS" FontSize="9.5" FontWeight="Bold"
                       Margin="2,0,0,6" Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />

            <Button DockPanel.Dock="Bottom" Content="Recheck" Margin="0,8,0,0" Padding="10,4"
                    Command="{Binding RecheckCommand}"
                    ToolTip="Look again for installed CLIs and stored keys" />

            <!--
                Adding a provider the app never heard of.

                Collapsed by default because most people never open it, and load-bearing because
                without it "bring your own provider" was true of the config file and false of the
                product: the pane could edit the eight providers appsettings.json ships and could not
                add a ninth, so reaching Groq or a local LM Studio meant hand-editing a JSON file in
                LocalAppData.
            -->
            <Expander DockPanel.Dock="Bottom" Margin="0,8,0,0" Header="Add a provider…"
                      Foreground="{DynamicResource Text.Secondary}" FontSize="11">
                <StackPanel Margin="2,8,2,0">
                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="DisplayName"
                              Padding="6,4" FontSize="11.5" />

                    <TextBlock Text="{Binding SelectedPreset.Note}" TextWrapping="Wrap"
                               FontSize="10.5" Margin="2,6,0,0"
                               Foreground="{DynamicResource Text.Secondary}" />

                    <!-- Only the blank row needs a name; a preset already has one, and asking for it
                         again would read as a required field. -->
                    <TextBox Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,7,0,0" Padding="6,4" FontSize="11.5"
                             mah:TextBoxHelper.Watermark="Name, e.g. Company gateway"
                             Visibility="{Binding IsCustomPreset, Converter={StaticResource B2V}}" />

                    <TextBox Text="{Binding NewProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,0" Padding="6,4" FontSize="11"
                             FontFamily="{DynamicResource Font.Data}"
                             mah:TextBoxHelper.Watermark="https://…/v1" />

                    <Button Content="Add" Margin="0,8,0,0" Padding="12,4"
                            HorizontalAlignment="Left"
                            Command="{Binding AddProviderCommand}" />
                </StackPanel>
            </Expander>

            <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}"
                     ItemTemplate="{StaticResource ProviderListRow}"
                     BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
                     Background="{DynamicResource Background.Surface}"
                     HorizontalContentAlignment="Stretch" />
        </DockPanel>

        <!-- ── The selected provider ─────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Padding="16,14"
                Background="{DynamicResource Background.Surface}"
                BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
                DataContext="{Binding Selected}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <!-- Only a provider the user added can be removed. A shipped one is layered
                             under appsettings.json and would be back on the next start, so the button
                             is absent rather than present and misleading. -->
                        <Button DockPanel.Dock="Right" Content="Remove" Padding="10,3"
                                VerticalAlignment="Top"
                                Command="{Binding DataContext.RemoveProviderCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsUserDefined, Converter={StaticResource B2V}}"
                                ToolTip="Forget this provider and its key" />

                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text.Header}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"
                               Margin="0,4,0,0" Foreground="{DynamicResource Text.Secondary}" />

                    <!-- ── Keyed providers ──────────────────────────────────────────────────── -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsKeyed, Converter={StaticResource B2V}}">
                        <TextBlock Text="API KEY" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />

                        <!-- A PasswordBox rather than a TextBox: a key pasted into a window someone may
                             be screen-sharing should not be sitting there in plain text. -->
                        <PasswordBox x:Name="KeyBox" Margin="0,5,0,0" Padding="7,5" FontSize="12"
                                     PasswordChanged="OnKeyChanged" />

                        <DockPanel Margin="0,7,0,0">
                            <Button DockPanel.Dock="Right" Content="Forget key" Padding="10,4"
                                    Margin="7,0,0,0"
                                    Command="{Binding DataContext.ClearKeyCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasKey, Converter={StaticResource B2V}}" />
                            <Button HorizontalAlignment="Left" Content="Save key" Padding="12,4"
                                    Command="{Binding DataContext.SaveKeyCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DockPanel>

                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="The key is encrypted for this Windows account and never leaves this machine except in requests to the provider you gave it for. You are billed by that provider for what the builder generates." />

                        <TextBlock Text="ENDPOINT" FontSize="9.5" FontWeight="Bold" Margin="0,16,0,0"
                                   Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,0" Padding="7,5" FontSize="12"
                                 FontFamily="{DynamicResource Font.Data}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="Point this at a compatible gateway or a local server (Ollama, LM Studio, vLLM) to keep the whole exchange on your own machine." />

                        <!-- Azure versions its API by date rather than by path, so this is not
                             optional there and there is nothing safe to guess: an old value silently
                             disables newer parameters, and an unrecognised one is a hard 404. -->
                        <StackPanel Visibility="{Binding IsAzure, Converter={StaticResource B2V}}">
                            <TextBlock Text="API VERSION" FontSize="9.5" FontWeight="Bold"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />
                            <TextBox Text="{Binding ApiVersion, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,5,0,0" Padding="7,5" FontSize="12"
                                     FontFamily="{DynamicResource Font.Data}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="Azure only. Take it from the resource's own API reference; a version it does not recognise answers 404 rather than an error you can read." />
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Agent CLIs ───────────────────────────────────────────────────────── -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsCli, Converter={StaticResource B2V}}">
                        <TextBlock Text="CLI PROFILE (OPTIONAL)" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />
                        <TextBox Text="{Binding CliProfile, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,0" Padding="7,5" FontSize="12"
                                 FontFamily="{DynamicResource Font.Data}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="A named configuration in the CLI's own settings. Leave it empty to use its default. There is no key to enter here — the CLI signs in with its own account, and its subscription pays for the tokens." />
                    </StackPanel>

                    <!-- ── Both ─────────────────────────────────────────────────────────────── -->
                    <DockPanel Margin="0,16,0,0">
                        <!-- Asking the endpoint what it serves is the only control here that proves
                             anything: a list coming back means the URL resolves, the key is accepted
                             AND the wire kind is right. Those are the three ways this goes wrong, and
                             otherwise they are told apart by spending a generation. -->
                        <Button DockPanel.Dock="Right" Content="Refresh models" Padding="10,3"
                                VerticalAlignment="Bottom"
                                Command="{Binding DataContext.RefreshModelsCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding ModelLabel}" FontSize="9.5" FontWeight="Bold"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Ai.Text.Brush}" Opacity="0.9" />
                    </DockPanel>

                    <!-- Editable, not a plain dropdown: the list is what the endpoint reports, and a
                         model it does not advertise is still often callable. -->
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,0,0" Padding="7,5" FontSize="12"
                              FontFamily="{DynamicResource Font.Data}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="10.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Empty means the provider's own default. The composer can still switch model per session — this is what it opens with." />

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Content="Make default" Padding="12,5"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.MakeDefaultCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Open the builder with this provider" />
                        <Button HorizontalAlignment="Left" Content="Save settings" Padding="12,5"
                                Command="{Binding DataContext.SaveProviderCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Footer ────────────────────────────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,5" IsCancel="True"
                    IsDefault="True" Click="OnClose" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Margin="0,0,12,0"
                       Foreground="{DynamicResource Text.Secondary}" Text="{Binding Status}" />
        </DockPanel>
    </Grid>
</mah:MetroWindow>
