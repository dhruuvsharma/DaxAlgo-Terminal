<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Independent copy of the shell code (no shared shell library across editions). The types keep
         their TradingTerminal.App.* namespaces — the three edition exes never reference each other,
         so identical namespaces can't clash; only the assembly name differs. -->
    <RootNamespace>TradingTerminal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon\DaxAlgoLogo.ico</ApplicationIcon>
    <Description>Basic-edition WPF shell — fully self-contained (no shared shell library): full broker selection, the strategy-plugin catalog, recorder, and base data/settings surfaces. A shell fix here must be applied to the other editions' copies separately.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Icon\DaxAlgoLogo.ico" />
    <Resource Include="Icon\DaxAlgoLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\TradingTerminal.Core\TradingTerminal.Core.csproj" />
    <ProjectReference Include="..\..\Sdk\DaxAlgo.Package\DaxAlgo.Package.csproj" />
    <ProjectReference Include="..\..\Execution\TradingTerminal.Execution\TradingTerminal.Execution.csproj" />
    <ProjectReference Include="..\..\Execution\TradingTerminal.ExecutionUi\TradingTerminal.ExecutionUi.csproj" />
    <!-- The sandboxed visualizer runtime behind a catalog card's "Add to chart". Core + SDK only.
         DAXQ-free, like everything else in this tree. -->
    <ProjectReference Include="..\..\Pipeline\TradingTerminal.Sandbox\TradingTerminal.Sandbox.csproj" />
    <ProjectReference Include="..\..\Pipeline\TradingTerminal.MarketData\TradingTerminal.MarketData.csproj" />
    <ProjectReference Include="..\..\Pipeline\TradingTerminal.Infrastructure\TradingTerminal.Infrastructure.csproj" />
    <ProjectReference Include="..\TradingTerminal.UI\TradingTerminal.UI.csproj" />
    <ProjectReference Include="..\TradingTerminal.Login\TradingTerminal.Login.csproj" />
    <ProjectReference Include="..\..\UI\TradingTerminal.Settings\TradingTerminal.Settings.csproj" />
    <ProjectReference Include="..\..\Tools\TradingTerminal.Recording\TradingTerminal.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Gitignored per-user secret overrides (API keys etc.). Optional — absent on clean checkouts. -->
    <None Include="..\..\..\..\appsettings.local.json" Link="appsettings.local.json" Condition="Exists('..\..\..\..\appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Launch-profile overrides, selected by DOTNET_ENVIRONMENT from Properties/launchSettings.json.
         Debug only, and guarded by Exists() because the set of profiles is per-edition (launchSettings.json
         is an owned file): the installers ship New User + Testing, the open-source edition ships neither and
         launches straight into the app on plain appsettings.json. Keeping the items identical in every
         edition is what lets this csproj stay a single promoted file. -->
    <None Include="..\..\..\..\appsettings.NewUser.json" Link="appsettings.NewUser.json"
          Condition="'$(Configuration)' == 'Debug' And Exists('..\..\..\..\appsettings.NewUser.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\..\appsettings.Testing.json" Link="appsettings.Testing.json"
          Condition="'$(Configuration)' == 'Debug' And Exists('..\..\..\..\appsettings.Testing.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>



</Project>
